<?xml version="1.0" encoding="utf-8"?>
<aiscript name="mule.fleet.commit" version="5">
  <params><param name="cfg"/><param name="plan"/></params>
  <attention min="unknown"><actions>
    <set_value name="$failure" exact="{61552,4321}.[$cfg.$ship.idcode]"/>
    <set_value name="$ship" exact="$cfg.$ship"/>
    <set_value name="$ok" exact="$plan.count gt 0 and $ship.isoperational and not $ship.orders.count and not $ship.cargo.count and not ($ship.pilot.$mwexFleetCfg.$origin != $cfg.$origin or $ship.pilot.$mwexFleetCfg.$signature != $cfg.$signature or $ship.pilot.$mwexFleetCfg.$commander != $cfg.$commander or $ship.pilot.$mwexFleetCfg.$bound != $cfg.$bound)"/>
    <set_value name="$needs" exact="table[]"/>
    <set_value name="$sources" exact="table[]"/>
    <set_value name="$cost" exact="0Cr"/>
    <set_value name="$receiverCost" exact="0Cr"/>
    <set_value name="$deliveryVolume" exact="0"/>
    <set_value name="$orders" exact="[]"/>
    <do_if value="not $ok"><return><retval name="ok" value="false"/><retval name="failure" value="$failure"/></return></do_if>
    <!-- Revalidate full plan BEFORE the first economic write. No real orders are used for feasibility tests. -->
    <do_for_each name="$leg" in="$plan">
      <do_for_each name="$offer" in="[$leg.$source,$leg.$need]">
        <run_script name="'mule.fleet.offer'">
          <param name="offer" value="$offer"/><param name="ship" value="$ship"/><param name="home" value="$cfg.$home"/><param name="maxDist" value="$cfg.$maxDist"/>
          <save_retval name="offer" variable="$valid"/><save_retval name="reason" variable="$offerReason"/>
        </run_script>
        <do_if value="not $valid">
          <set_value name="$ok" exact="false"/>
          <set_value name="$failure" exact="'COMMIT_CHECK ship=%s station=%s ware=%s reason=%s'.[$ship.idcode,$offer.owner,$offer.ware,$offerReason]" /><debug_to_file directory="'MulesExtended'" name="'M4 Capacity Dispatch'" append="true" text="'COMMIT_CHECK ship=%s station=%s ware=%s reason=%s'.[$ship.idcode,$offer.owner,$offer.ware,$offerReason]"/>
        </do_if>
        <do_else>
          <run_script name="'mule.fleet.price'"><param name="offer" value="$valid"/><param name="ship" value="$ship"/><save_retval name="price" variable="$livePrice"/><save_retval name="ok" variable="$priced"/></run_script>
          <do_if value="not $priced or $livePrice != (if $offer.isbuyoffer then $leg.$sellprice else $leg.$buyprice)">
            <set_value name="$ok" exact="false"/>
            <set_value name="$failure" exact="'COMMIT_CHECK %s ship=%s station=%s ware=%s planned=%sCr live=%sCr priceAvailable=%s'.[{61552,4323},$ship.idcode,$offer.owner,$offer.ware,(if $offer.isbuyoffer then $leg.$sellprice else $leg.$buyprice)/1Cr,$livePrice/1Cr,$priced]" /><debug_to_file directory="'MulesExtended'" name="'M4 Capacity Dispatch'" append="true" text="'COMMIT_CHECK %s ship=%s station=%s ware=%s planned=%sCr live=%sCr priceAvailable=%s'.[{61552,4323},$ship.idcode,$offer.owner,$offer.ware,(if $offer.isbuyoffer then $leg.$sellprice else $leg.$buyprice)/1Cr,$livePrice/1Cr,$priced]"/>
          </do_if>
        </do_else>
      </do_for_each>
      <do_if value="$leg.$source.owner.owner == $ship.owner and ($leg.$source.owner.cargo.{$leg.$ware}.target le 0 or $leg.$source.owner.cargo.{$leg.$ware}.count*100 le $leg.$source.owner.cargo.{$leg.$ware}.target*$cfg.$playerStockThreshold)">
        <set_value name="$ok" exact="false"/>
        <set_value name="$failure" exact="{61552,4303}.[$leg.$source.owner.knownname,$leg.$ware.name,$leg.$source.owner.cargo.{$leg.$ware}.count,$leg.$source.owner.cargo.{$leg.$ware}.target,$cfg.$playerStockThreshold]" /><debug_to_file directory="'MulesExtended'" name="'M4 Capacity Dispatch'" append="true" text="{61552,4303}.[$leg.$source.owner.knownname,$leg.$ware.name,$leg.$source.owner.cargo.{$leg.$ware}.count,$leg.$source.owner.cargo.{$leg.$ware}.target,$cfg.$playerStockThreshold]"/>
      </do_if>
      <set_value name="$needs.{$leg.$need}" exact="(if $needs.{$leg.$need}? then $needs.{$leg.$need} else 0)+$leg.$amount"/>
      <set_value name="$sources.{$leg.$source}" exact="(if $sources.{$leg.$source}? then $sources.{$leg.$source} else 0)+$leg.$amount"/>
      <set_value name="$cost" operation="add" exact="if $leg.$source.buyfree.{$ship} then 0Cr else $leg.$amount*$leg.$buyprice"/>
      <set_value name="$receiverCost" operation="add" exact="if $leg.$need.buyfree or $leg.$need.owner.owner == $ship.owner then 0Cr else $leg.$amount*$leg.$sellprice"/>
      <set_value name="$deliveryVolume" operation="add" exact="$leg.$amount*$leg.$ware.volume"/>
    </do_for_each>
    <do_for_each name="$offer" valuename="$quantity" in="$needs">
      <run_script name="'mule.fleet.net'"><param name="offer" value="$offer"/><save_retval name="net" variable="$net"/></run_script>
      <do_if value="$net lt $quantity"><set_value name="$ok" exact="false"/><set_value name="$failure" exact="'COMMIT_CHECK %s station=%s ware=%s planned=%s net=%s'.[{61552,4325},$offer.owner,$offer.ware,$quantity,$net]" /><debug_to_file directory="'MulesExtended'" name="'M4 Capacity Dispatch'" append="true" text="'COMMIT_CHECK %s station=%s ware=%s planned=%s net=%s'.[{61552,4325},$offer.owner,$offer.ware,$quantity,$net]"/></do_if>
    </do_for_each>
    <do_for_each name="$offer" valuename="$quantity" in="$sources">
      <run_script name="'mule.fleet.net'"><param name="offer" value="$offer"/><save_retval name="net" variable="$net"/></run_script>
      <do_if value="$net lt $quantity"><set_value name="$ok" exact="false"/><set_value name="$failure" exact="'COMMIT_CHECK %s station=%s ware=%s planned=%s net=%s'.[{61552,4325},$offer.owner,$offer.ware,$quantity,$net]" /><debug_to_file directory="'MulesExtended'" name="'M4 Capacity Dispatch'" append="true" text="'COMMIT_CHECK %s station=%s ware=%s planned=%s net=%s'.[{61552,4325},$offer.owner,$offer.ware,$quantity,$net]"/></do_if>
    </do_for_each>
    <do_if value="$cost gt $ship.money or $receiverCost gt $plan.{1}.$need.owner.money"><set_value name="$ok" exact="false"/><set_value name="$failure" exact="'COMMIT_CHECK %s ship=%s cost=%sCr budget=%sCr receiverCost=%sCr receiverBudget=%sCr'.[{61552,4326},$ship.idcode,$cost/1Cr,$ship.money/1Cr,$receiverCost/1Cr,$plan.{1}.$need.owner.money/1Cr]" /><debug_to_file directory="'MulesExtended'" name="'M4 Capacity Dispatch'" append="true" text="'COMMIT_CHECK %s ship=%s cost=%sCr budget=%sCr receiverCost=%sCr receiverBudget=%sCr'.[{61552,4326},$ship.idcode,$cost/1Cr,$ship.money/1Cr,$receiverCost/1Cr,$plan.{1}.$need.owner.money/1Cr]"/></do_if>
    <do_if value="$deliveryVolume gt $plan.{1}.$need.owner.cargo.free.{$plan.{1}.$ware.transporttag} or $deliveryVolume gt $ship.cargo.free.{$plan.{1}.$ware.transporttag}"><set_value name="$ok" exact="false"/><set_value name="$failure" exact="'COMMIT_CHECK %s ship=%s volume=%s shipFree=%s receiverFree=%s'.[{61552,4327},$ship.idcode,$deliveryVolume,$ship.cargo.free.{$plan.{1}.$ware.transporttag},$plan.{1}.$need.owner.cargo.free.{$plan.{1}.$ware.transporttag}]" /><debug_to_file directory="'MulesExtended'" name="'M4 Capacity Dispatch'" append="true" text="'COMMIT_CHECK %s ship=%s volume=%s shipFree=%s receiverFree=%s'.[{61552,4327},$ship.idcode,$deliveryVolume,$ship.cargo.free.{$plan.{1}.$ware.transporttag},$plan.{1}.$need.owner.cargo.free.{$plan.{1}.$ware.transporttag}]"/></do_if>
    <do_if value="not $ship.isoperational or $ship.orders.count or ($ship.pilot.$mwexFleetCfg.$origin != $cfg.$origin or $ship.pilot.$mwexFleetCfg.$signature != $cfg.$signature or $ship.pilot.$mwexFleetCfg.$commander != $cfg.$commander or $ship.pilot.$mwexFleetCfg.$bound != $cfg.$bound)"><set_value name="$ok" exact="false"/><set_value name="$failure" exact="'COMMIT_CHECK %s ship=%s origin=%s liveOrder=%s home=%s threshold=%s'.[{61552,4328},$ship.idcode,$cfg.$origin,$ship.defaultorder,$cfg.$home,$cfg.$playerStockThreshold]" /><debug_to_file directory="'MulesExtended'" name="'M4 Capacity Dispatch'" append="true" text="'COMMIT_CHECK %s ship=%s origin=%s liveOrder=%s home=%s threshold=%s'.[{61552,4328},$ship.idcode,$cfg.$origin,$ship.defaultorder,$cfg.$home,$cfg.$playerStockThreshold]"/></do_if>
    <do_if value="$ship.defaultorder != $cfg.$origin or ($cfg.$bound and $ship.commander != $cfg.$commander)"><set_value name="$ok" exact="false"/><set_value name="$failure" exact="'COMMIT_CHECK %s ship=%s origin=%s liveOrder=%s home=%s threshold=%s'.[{61552,4328},$ship.idcode,$cfg.$origin,$ship.defaultorder,$cfg.$home,$cfg.$playerStockThreshold]" /><debug_to_file directory="'MulesExtended'" name="'M4 Capacity Dispatch'" append="true" text="'COMMIT_CHECK %s ship=%s origin=%s liveOrder=%s home=%s threshold=%s'.[{61552,4328},$ship.idcode,$cfg.$origin,$ship.defaultorder,$cfg.$home,$cfg.$playerStockThreshold]"/></do_if>
    <do_if value="$ship.defaultorder.id == 'SupplyMule' and ($ship.defaultorder.$home != $cfg.$home or $ship.defaultorder.$maxDist != $cfg.$maxDist or $ship.defaultorder.$dedicatedServe != $cfg.$dedicatedServe or $ship.defaultorder.$allowPlayerSuppliers != $cfg.$allowPlayerSuppliers or $ship.defaultorder.$allowAiSuppliers != $cfg.$allowAiSuppliers or $ship.defaultorder.$allowBuildstorage != $cfg.$allowBuildstorage or $ship.defaultorder.$allowResources != $cfg.$allowResources or $ship.defaultorder.$allowIntermediates != $cfg.$allowIntermediates or $ship.defaultorder.$allowTradewares != $cfg.$allowTradewares or $ship.defaultorder.$lockWares != $cfg.$lockWares or $ship.defaultorder.$maxTrades != $cfg.$maxTrades or $ship.defaultorder.$minCargoUsed != $cfg.$minCargoUsed or (if $ship.defaultorder.$playerStockThreshold? then $ship.defaultorder.$playerStockThreshold else 50) != $cfg.$playerStockThreshold or $ship.defaultorder.$corridorDepth != $cfg.$corridorDepth or $ship.defaultorder.$corridorMarkup != $cfg.$corridorMarkup or '%s'.[$ship.defaultorder.$specialWareBasket] != '%s'.[$cfg.$wares])"><set_value name="$ok" exact="false"/><set_value name="$failure" exact="'COMMIT_CHECK %s ship=%s origin=%s liveOrder=%s home=%s threshold=%s'.[{61552,4328},$ship.idcode,$cfg.$origin,$ship.defaultorder,$cfg.$home,$cfg.$playerStockThreshold]" /><debug_to_file directory="'MulesExtended'" name="'M4 Capacity Dispatch'" append="true" text="'COMMIT_CHECK %s ship=%s origin=%s liveOrder=%s home=%s threshold=%s'.[{61552,4328},$ship.idcode,$cfg.$origin,$ship.defaultorder,$cfg.$home,$cfg.$playerStockThreshold]"/></do_if>
    <do_if value="not $ok">
      <debug_to_file directory="'MulesExtended'" name="'M4 Capacity Dispatch'" append="true" text="{61552,4321}.[$ship.idcode]"/>
      <return><retval name="ok" value="false"/><retval name="failure" value="$failure"/></return>
    </do_if>
    <run_script name="'mule.fleet.report'"><param name="cfg" value="$cfg"/></run_script>
    <set_value name="$ship.pilot.$mwexFleetVoyage" exact="$plan"/>
    <!-- No waits, no per-leg immediate=true: enqueue ALL pickups before ALL deliveries. -->
    <do_for_each name="$leg" in="$plan">
      <create_trade_order object="$ship" tradeoffer="$leg.$source" amount="$leg.$amount" immediate="false" name="$order"/>
      <do_if value="@$order.exists">
        <append_to_list name="$orders" exact="$order"/>
        <do_if value="@$order.trade.exists and $order.trade.amount gt 0">
          <append_to_list name="global.$mwexFleetPending" exact="table[$ship=$ship,$offer=$leg.$source,$order=$order,$amount=$order.trade.amount]"/>
        </do_if>
      </do_if>
      <do_if value="@$order.exists and @$order.trade.exists and $order.trade.amount == $leg.$amount">
        <set_value name="$leg.$buyOrder" exact="$order"/>
      </do_if>
      <do_else>
        <set_value name="$ok" exact="false"/><break/>
      </do_else>
    </do_for_each>
    <do_if value="$ok">
      <do_for_each name="$leg" in="$plan">
        <create_trade_order object="$ship" tradeoffer="$leg.$need" amount="$leg.$amount" immediate="false" name="$order"/>
        <do_if value="@$order.exists">
          <append_to_list name="$orders" exact="$order"/>
          <do_if value="@$order.trade.exists and $order.trade.amount gt 0">
            <append_to_list name="global.$mwexFleetPending" exact="table[$ship=$ship,$offer=$leg.$need,$order=$order,$amount=$order.trade.amount]"/>
          </do_if>
        </do_if>
        <do_if value="@$order.exists and @$order.trade.exists and $order.trade.amount == $leg.$amount">
          <set_value name="$leg.$sellOrder" exact="$order"/>
        </do_if>
        <do_else>
          <set_value name="$ok" exact="false"/><break/>
        </do_else>
      </do_for_each>
    </do_if>
    <do_if value="not $ok">
      <!-- Critical/running trades are NOT assumed cancellable. Keep voyage identity for real-cargo recovery. -->
      <do_for_each name="$created" in="$orders" reverse="true">
        <do_if value="@$created.exists and not $created.isrunning"><cancel_order order="$created"/></do_if>
      </do_for_each>
      <set_value name="$failure" exact="{61552,4205}.[$ship.knownname]"/>
      <write_to_logbook category="alerts" object="$ship" title="{61552,4200}" text="{61552,4205}.[$ship.knownname]" interaction="showonmap"/>
    </do_if>
    <debug_to_file directory="'MulesExtended'" name="'M4 Capacity Dispatch'" append="true"
      text="'COMMIT ship=%s lots=%s orders=%s success=%s'.[$ship.idcode,$plan.count,$orders.count,$ok]"/>
    <do_for_each name="$queued" in="$ship.orders" counter="$index">
      <debug_to_file directory="'MulesExtended'" name="'M4 Capacity Dispatch'" append="true"
        text="'QUEUE ship=%s index=%s order=%s trade=%s amount=%s state=%s'.[$ship.idcode,$index,$queued,$queued.trade,@$queued.trade.amount,$queued.state]"/>
    </do_for_each>
    <return><retval name="ok" value="$ok"/><retval name="failure" value="if $ok then null else $failure"/></return>
  </actions></attention>
</aiscript>
