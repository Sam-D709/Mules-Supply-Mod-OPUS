<?xml version="1.0" encoding="utf-8"?>
<aiscript name="mule.fleet.commit" version="10">
  <params>
    <param name="cfg" />
    <param name="plan" />
    <param name="diagnostic" default="null" />
    <param name="hub" default="null" />
  </params>
  <patch sinceversion="9">
    <do_if value="$lock?">
      <do_if value="@global.$mwexFleetLock == $lock">
        <remove_value name="global.$mwexFleetLock" />
      </do_if>
    </do_if>
    <return>
      <retval name="ok" value="false" />
      <retval name="failure" value="'ship_changed'" />
      <retval name="status" value="'commit_ship'" />
    </return>
  </patch>
  <patch sinceversion="8">
    <do_if value="$lock?">
      <do_if value="@global.$mwexFleetLock == $lock">
        <remove_value name="global.$mwexFleetLock" />
      </do_if>
    </do_if>
    <return>
      <retval name="ok" value="false" />
      <retval name="failure" value="'ship_changed'" />
      <retval name="status" value="'commit_ship'" />
    </return>
  </patch>
  <patch sinceversion="7">
    <return>
      <retval name="ok" value="false" />
      <retval name="failure" value="'ship_changed'" />
    </return>
  </patch>
  <patch sinceversion="10">
    <do_if value="$lock?">
      <do_if value="@global.$mwexFleetLock == $lock">
        <remove_value name="global.$mwexFleetLock" />
      </do_if>
    </do_if>
    <return>
      <retval name="ok" value="false" />
      <retval name="failure" value="'ship_changed'" />
      <retval name="status" value="'commit_ship'" />
    </return>
  </patch>
  <attention min="unknown">
    <actions>
      <set_value name="$failure" exact="{61552,4455}" />
      <set_value name="$status" exact="'commit_ship'" />
      <set_value name="$ship" exact="$cfg.$ship" />
      <do_if value="not $diagnostic">
        <set_value name="$diagnostic" exact="table[$ship=$ship,$attempt=@$ship.pilot.$mwexFleetPlanSerial,$relaxed=false,$price=0,$range=0,$route=0,$lots=$plan.count,$volume=0,$capacity=if $plan.count then $ship.cargo.{$plan.{1}.$ware}.max*$plan.{1}.$ware.volume else 0,$pool=0,$secondaryChecks=0,$secondaryAdded=0,$budgetExhausted=false,$commitFailed=false,$lastFailure=null,$stop=0,$draft=$plan,$recorded=false]" />
        <do_for_each name="$fallbackLeg" in="$plan">
          <set_value name="$diagnostic.$volume" operation="add" exact="$fallbackLeg.$amount*$fallbackLeg.$ware.volume" />
        </do_for_each>
      </do_if>
      <set_value name="$ok" exact="$plan.count gt 0 and $ship.isoperational and not $ship.orders.count and not $ship.cargo.count and not ($ship.pilot.$mwexFleetCfg.$origin != $cfg.$origin or $ship.pilot.$mwexFleetCfg.$signature != $cfg.$signature or $ship.pilot.$mwexFleetCfg.$commander != $cfg.$commander or $ship.pilot.$mwexFleetCfg.$bound != $cfg.$bound)" />
      <do_if value="@global.$mwexDebug">
        <set_value name="$diagnostic.$phase" exact="'commit_validate'" />
        <set_value name="$diagnostic.$voyage" exact="'%s/%s/%s'.[$ship,player.age,@$diagnostic.$attempt]" />
      </do_if>
      <do_if value="@global.$mwexDebug">
        <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
        <set_value name="$mwtrace_text" exact="'COMMIT_BEGIN plannedLots=%s initialEligible=%s orders=%s cargo=%s signature=%s'.[$plan.count,$ok,$ship.orders.count,$ship.cargo.count,$cfg.$signature]" />
        <set_value name="$mwtrace_file" exact="'orders'" />
        <include_interrupt_actions ref="MWEX_Fleet_trace" />
      </do_if>
      <set_value name="$needs" exact="table[]" />
      <set_value name="$sources" exact="table[]" />
      <set_value name="$cost" exact="0Cr" />
      <set_value name="$receiverCost" exact="0Cr" />
      <set_value name="$deliveryVolume" exact="0" />
      <set_value name="$orders" exact="[]" />
      <do_if value="not $ok">
        <return>
          <retval name="ok" value="false" />
          <retval name="failure" value="$failure" />
          <retval name="status" value="$status" />
        </return>
      </do_if>
      <set_value name="$mwrepair_cfg" exact="$cfg" />
      <set_value name="$mwrepair_plan" exact="$plan" />
      <set_value name="$mwrepair_diagnostic" exact="$diagnostic" />
      <include_interrupt_actions ref="MWEX_Fleet_repair" />
      <set_value name="$plan" exact="$mwrepair_out" />
      <!-- Revalidate full plan BEFORE the first economic write. No real orders are used for feasibility tests. -->
      <do_for_each name="$leg" in="$plan">
        <do_for_each name="$offer" in="[$leg.$source,$leg.$need]">
          <set_value name="$mwoffer_offer" exact="$offer" />
          <set_value name="$mwoffer_ship" exact="$ship" />
          <set_value name="$mwoffer_home" exact="$cfg.$home" />
          <set_value name="$mwoffer_maxDist" exact="$cfg.$maxDist" />
          <include_interrupt_actions ref="MWEX_Fleet_offer" />
          <set_value name="$valid" exact="$mwoffer_out_offer" />
          <set_value name="$offerReason" exact="$mwoffer_out_reason" />
          <do_if value="not $valid">
            <set_value name="$ok" exact="false" />
            <set_value name="$failure" exact="{61552,4450}.[$offer.owner.knownname,$offer.ware.name]" />
            <set_value name="$status" exact="'commit_offer'" />
            <do_if value="@global.$mwexDebug">
              <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
              <set_value name="$mwtrace_text" exact="'COMMIT_CHECK ship=%s station=%s ware=%s reason=%s'.[$ship.idcode,$offer.owner,$offer.ware,$offerReason]" />
              <set_value name="$mwtrace_file" exact="'orders'" />
              <include_interrupt_actions ref="MWEX_Fleet_trace" />
            </do_if>
          </do_if>
          <do_else>
            <set_value name="$mwprice_offer" exact="$valid" />
            <set_value name="$mwprice_ship" exact="$ship" />
            <set_value name="$mwprice_cache" exact="table[]" />
            <include_interrupt_actions ref="MWEX_Fleet_price" />
            <set_value name="$livePrice" exact="$mwprice_out_price" />
            <set_value name="$priced" exact="$mwprice_out_ok" />
            <do_if value="not $priced">
              <set_value name="$ok" exact="false" />
              <set_value name="$failure" exact="{61552,4451}.[$offer.owner.knownname,$offer.ware.name]" />
              <set_value name="$status" exact="'commit_price'" />
              <do_if value="@global.$mwexDebug">
                <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
                <set_value name="$mwtrace_text" exact="'COMMIT_CHECK %s ship=%s station=%s ware=%s planned=%sCr live=%sCr priceAvailable=%s'.[{61552,4323},$ship.idcode,$offer.owner,$offer.ware,(if $offer.isbuyoffer then $leg.$sellprice else $leg.$buyprice)/1Cr,$livePrice/1Cr,$priced]" />
                <set_value name="$mwtrace_file" exact="'orders'" />
                <include_interrupt_actions ref="MWEX_Fleet_trace" />
              </do_if>
            </do_if>
            <do_elseif value="$offer.isbuyoffer">
              <set_value name="$leg.$sellprice" exact="$livePrice" />
            </do_elseif>
            <do_else>
              <set_value name="$leg.$buyprice" exact="$livePrice" />
            </do_else>
          </do_else>
        </do_for_each>
        <set_value name="$builder" exact="$cfg.$allowBuildstorage and not $cfg.$allowResources and not $cfg.$allowIntermediates and $leg.$need.owner.isclass.buildstorage and $leg.$need.owner.owner == faction.player" />
        <do_if value="$leg.$source.owner.owner != $ship.owner and not $builder and $leg.$sellprice le $leg.$buyprice">
          <set_value name="$ok" exact="false" />
          <set_value name="$failure" exact="{61552,4457}.[$leg.$ware.name,$leg.$buyprice/1Cr,$leg.$sellprice/1Cr]" />
          <set_value name="$status" exact="'commit_spread'" />
          <do_if value="@global.$mwexDebug">
            <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
            <set_value name="$mwtrace_text" exact="'COMMIT_CHECK code=spread ware=%s source=%s receiver=%s buy=%s sell=%s builder=%s'.[$leg.$ware,$leg.$source.owner,$leg.$need.owner,$leg.$buyprice/1Cr,$leg.$sellprice/1Cr,$builder]" />
            <set_value name="$mwtrace_file" exact="'orders'" />
            <include_interrupt_actions ref="MWEX_Fleet_trace" />
          </do_if>
        </do_if>
        <do_if value="$leg.$source.owner.owner == $ship.owner and ($leg.$source.owner.cargo.{$leg.$ware}.target le 0 or $leg.$source.owner.cargo.{$leg.$ware}.count*100 le $leg.$source.owner.cargo.{$leg.$ware}.target*$cfg.$playerStockThreshold)">
          <set_value name="$ok" exact="false" />
          <set_value name="$failure" exact="{61552,4456}.[$leg.$source.owner.knownname,$leg.$ware.name,$cfg.$playerStockThreshold]" />
          <set_value name="$status" exact="'commit_stock'" />
          <do_if value="@global.$mwexDebug">
            <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
            <set_value name="$mwtrace_text" exact="{61552,4303}.[$leg.$source.owner.knownname,$leg.$ware.name,$leg.$source.owner.cargo.{$leg.$ware}.count,$leg.$source.owner.cargo.{$leg.$ware}.target,$cfg.$playerStockThreshold]" />
            <set_value name="$mwtrace_file" exact="'orders'" />
            <include_interrupt_actions ref="MWEX_Fleet_trace" />
          </do_if>
        </do_if>
        <set_value name="$needs.{$leg.$need}" exact="(if $needs.{$leg.$need}? then $needs.{$leg.$need} else 0)+$leg.$amount" />
        <set_value name="$sources.{$leg.$source}" exact="(if $sources.{$leg.$source}? then $sources.{$leg.$source} else 0)+$leg.$amount" />
        <set_value name="$cost" operation="add" exact="if $leg.$source.buyfree.{$ship} then 0Cr else $leg.$amount*$leg.$buyprice" />
        <set_value name="$receiverCost" operation="add" exact="if $leg.$need.buyfree or $leg.$need.owner.owner == $ship.owner then 0Cr else $leg.$amount*$leg.$sellprice" />
        <set_value name="$deliveryVolume" operation="add" exact="$leg.$amount*$leg.$ware.volume" />
      </do_for_each>
      <do_if value="not $ok">
        <return>
          <retval name="ok" value="false" />
          <retval name="failure" value="$failure" />
          <retval name="status" value="$status" />
        </return>
      </do_if>
      <!-- Final net checks and economic writes use only schema-validated non-blocking actions, including all helper includes. -->
      <do_if value="global.$mwexFleetLock?">
        <do_if value="not @global.$mwexFleetLock.$actor.exists or player.age gt global.$mwexFleetLock.$time+30s">
          <remove_value name="global.$mwexFleetLock" />
        </do_if>
      </do_if>
      <do_if value="global.$mwexFleetLock?">
        <return>
          <retval name="ok" value="false" />
          <retval name="failure" value="'commit_busy'" />
          <retval name="status" value="'commit_busy'" />
        </return>
      </do_if>
      <set_value name="$lock" exact="table[$actor=this,$time=player.age]" />
      <set_value name="global.$mwexFleetLock" exact="$lock" />
      <do_for_each name="$offer" valuename="$quantity" in="$needs">
        <set_value name="$mwnet_offer" exact="$offer" />
        <include_interrupt_actions ref="MWEX_Fleet_net" />
        <set_value name="$net" exact="$mwnet_out_net" />
        <do_if value="$net lt $quantity">
          <set_value name="$ok" exact="false" />
          <set_value name="$failure" exact="{61552,4452}.[$offer.owner.knownname,$offer.ware.name,$quantity,$net]" />
          <set_value name="$status" exact="'commit_quantity'" />
          <do_if value="@global.$mwexDebug">
            <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
            <set_value name="$mwtrace_text" exact="'COMMIT_CHECK %s station=%s ware=%s planned=%s net=%s'.[{61552,4325},$offer.owner,$offer.ware,$quantity,$net]" />
            <set_value name="$mwtrace_file" exact="'orders'" />
            <include_interrupt_actions ref="MWEX_Fleet_trace" />
          </do_if>
        </do_if>
      </do_for_each>
      <do_for_each name="$offer" valuename="$quantity" in="$sources">
        <set_value name="$mwnet_offer" exact="$offer" />
        <include_interrupt_actions ref="MWEX_Fleet_net" />
        <set_value name="$net" exact="$mwnet_out_net" />
        <do_if value="$net lt $quantity">
          <set_value name="$ok" exact="false" />
          <set_value name="$failure" exact="{61552,4452}.[$offer.owner.knownname,$offer.ware.name,$quantity,$net]" />
          <set_value name="$status" exact="'commit_quantity'" />
          <do_if value="@global.$mwexDebug">
            <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
            <set_value name="$mwtrace_text" exact="'COMMIT_CHECK %s station=%s ware=%s planned=%s net=%s'.[{61552,4325},$offer.owner,$offer.ware,$quantity,$net]" />
            <set_value name="$mwtrace_file" exact="'orders'" />
            <include_interrupt_actions ref="MWEX_Fleet_trace" />
          </do_if>
        </do_if>
      </do_for_each>
      <do_if value="$cost gt $ship.money or $receiverCost gt $plan.{1}.$need.owner.money">
        <set_value name="$ok" exact="false" />
        <set_value name="$failure" exact="{61552,4453}.[$cost/1Cr,$ship.money/1Cr,$receiverCost/1Cr,$plan.{1}.$need.owner.money/1Cr]" />
        <set_value name="$status" exact="'commit_funds'" />
        <do_if value="@global.$mwexDebug">
          <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
          <set_value name="$mwtrace_text" exact="'COMMIT_CHECK %s ship=%s cost=%sCr budget=%sCr receiverCost=%sCr receiverBudget=%sCr'.[{61552,4326},$ship.idcode,$cost/1Cr,$ship.money/1Cr,$receiverCost/1Cr,$plan.{1}.$need.owner.money/1Cr]" />
          <set_value name="$mwtrace_file" exact="'orders'" />
          <include_interrupt_actions ref="MWEX_Fleet_trace" />
        </do_if>
      </do_if>
      <do_if value="$deliveryVolume gt $plan.{1}.$need.owner.cargo.free.{$plan.{1}.$ware.transporttag} or $deliveryVolume gt $ship.cargo.free.{$plan.{1}.$ware.transporttag}">
        <set_value name="$ok" exact="false" />
        <set_value name="$failure" exact="{61552,4454}.[$deliveryVolume,$ship.cargo.free.{$plan.{1}.$ware.transporttag},$plan.{1}.$need.owner.cargo.free.{$plan.{1}.$ware.transporttag}]" />
        <set_value name="$status" exact="'commit_cargo'" />
        <do_if value="@global.$mwexDebug">
          <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
          <set_value name="$mwtrace_text" exact="'COMMIT_CHECK %s ship=%s volume=%s shipFree=%s receiverFree=%s'.[{61552,4327},$ship.idcode,$deliveryVolume,$ship.cargo.free.{$plan.{1}.$ware.transporttag},$plan.{1}.$need.owner.cargo.free.{$plan.{1}.$ware.transporttag}]" />
          <set_value name="$mwtrace_file" exact="'orders'" />
          <include_interrupt_actions ref="MWEX_Fleet_trace" />
        </do_if>
      </do_if>
      <do_if value="not $ship.isoperational or $ship.orders.count or ($ship.pilot.$mwexFleetCfg.$origin != $cfg.$origin or $ship.pilot.$mwexFleetCfg.$signature != $cfg.$signature or $ship.pilot.$mwexFleetCfg.$commander != $cfg.$commander or $ship.pilot.$mwexFleetCfg.$bound != $cfg.$bound)">
        <set_value name="$ok" exact="false" />
        <set_value name="$failure" exact="{61552,4455}" />
        <set_value name="$status" exact="'commit_ship'" />
        <do_if value="@global.$mwexDebug">
          <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
          <set_value name="$mwtrace_text" exact="'COMMIT_CHECK %s ship=%s origin=%s liveOrder=%s home=%s threshold=%s'.[{61552,4328},$ship.idcode,$cfg.$origin,$ship.defaultorder,$cfg.$home,$cfg.$playerStockThreshold]" />
          <set_value name="$mwtrace_file" exact="'orders'" />
          <include_interrupt_actions ref="MWEX_Fleet_trace" />
        </do_if>
      </do_if>
      <do_if value="$ship.defaultorder != $cfg.$origin or ($cfg.$bound and $ship.commander != $cfg.$commander)">
        <set_value name="$ok" exact="false" />
        <set_value name="$failure" exact="{61552,4455}" />
        <set_value name="$status" exact="'commit_ship'" />
        <do_if value="@global.$mwexDebug">
          <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
          <set_value name="$mwtrace_text" exact="'COMMIT_CHECK %s ship=%s origin=%s liveOrder=%s home=%s threshold=%s'.[{61552,4328},$ship.idcode,$cfg.$origin,$ship.defaultorder,$cfg.$home,$cfg.$playerStockThreshold]" />
          <set_value name="$mwtrace_file" exact="'orders'" />
          <include_interrupt_actions ref="MWEX_Fleet_trace" />
        </do_if>
      </do_if>
      <do_if value="$ship.defaultorder.id == 'SupplyMule' and ($ship.defaultorder.$home != $cfg.$home or $ship.defaultorder.$maxDist != $cfg.$maxDist or $ship.defaultorder.$dedicatedServe != $cfg.$dedicatedServe or $ship.defaultorder.$allowPlayerSuppliers != $cfg.$allowPlayerSuppliers or $ship.defaultorder.$allowAiSuppliers != $cfg.$allowAiSuppliers or $ship.defaultorder.$allowBuildstorage != $cfg.$allowBuildstorage or $ship.defaultorder.$allowResources != $cfg.$allowResources or $ship.defaultorder.$allowIntermediates != $cfg.$allowIntermediates or $ship.defaultorder.$allowTradewares != $cfg.$allowTradewares or $ship.defaultorder.$lockWares != $cfg.$lockWares or $ship.defaultorder.$maxTrades != $cfg.$maxTrades or $ship.defaultorder.$minCargoUsed != $cfg.$minCargoUsed or (if $ship.defaultorder.$playerStockThreshold? then $ship.defaultorder.$playerStockThreshold else 50) != $cfg.$playerStockThreshold or $ship.defaultorder.$corridorDepth != $cfg.$corridorDepth or $ship.defaultorder.$corridorMarkup != $cfg.$corridorMarkup or '%s'.[$ship.defaultorder.$specialWareBasket] != '%s'.[$cfg.$wares])">
        <set_value name="$ok" exact="false" />
        <set_value name="$failure" exact="{61552,4455}" />
        <set_value name="$status" exact="'commit_ship'" />
        <do_if value="@global.$mwexDebug">
          <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
          <set_value name="$mwtrace_text" exact="'COMMIT_CHECK %s ship=%s origin=%s liveOrder=%s home=%s threshold=%s'.[{61552,4328},$ship.idcode,$cfg.$origin,$ship.defaultorder,$cfg.$home,$cfg.$playerStockThreshold]" />
          <set_value name="$mwtrace_file" exact="'orders'" />
          <include_interrupt_actions ref="MWEX_Fleet_trace" />
        </do_if>
      </do_if>
      <do_if value="not $ok">
        <do_if value="@global.$mwexDebug">
          <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
          <set_value name="$mwtrace_text" exact="{61552,4321}.[$ship.idcode]" />
          <set_value name="$mwtrace_file" exact="'orders'" />
          <include_interrupt_actions ref="MWEX_Fleet_trace" />
        </do_if>
        <do_if value="@global.$mwexFleetLock == $lock">
          <remove_value name="global.$mwexFleetLock" />
        </do_if>
        <return>
          <retval name="ok" value="false" />
          <retval name="failure" value="$failure" />
          <retval name="status" value="$status" />
        </return>
      </do_if>
      <set_value name="$mwreport_cfg" exact="$cfg" />
      <set_value name="$mwreport_reason" exact="null" />
      <include_interrupt_actions ref="MWEX_Fleet_report" />
      <set_value name="$ship.pilot.$mwexFleetVoyage" exact="$plan" />
      <do_if value="@global.$mwexDebug">
        <set_value name="$ship.pilot.$mwexM4Voyage" exact="$diagnostic.$voyage" />
        <set_value name="$diagnostic.$phase" exact="'create_orders'" />
      </do_if>
      <!-- No waits, no per-leg immediate=true: enqueue ALL pickups before ALL deliveries. -->
      <do_for_each name="$leg" in="$plan">
        <create_trade_order object="$ship" tradeoffer="$leg.$source" amount="$leg.$amount" immediate="false" name="$order" />
        <set_value name="$mwlog_order_cfg" exact="$cfg" />
        <set_value name="$mwlog_order_diagnostic" exact="$diagnostic" />
        <set_value name="$mwlog_order" exact="$order" />
        <set_value name="$mwlog_order_leg" exact="$leg" />
        <set_value name="$mwlog_side" exact="'buy'" />
        <include_interrupt_actions ref="MWEX_Log_order" />
        <do_if value="@$order.exists">
          <append_to_list name="$orders" exact="$order" />
          <do_if value="@$order.trade.exists and $order.trade.amount gt 0">
            <append_to_list name="global.$mwexFleetPending" exact="table[$ship=$ship,$offer=$leg.$source,$order=$order,$amount=$order.trade.amount]" />
            <do_if value="@global.$mwexDebug">
              <set_value name="$logHold" exact="global.$mwexFleetPending.{global.$mwexFleetPending.count}" />
              <set_value name="$logHold.$logOrderId" exact="'%s'.[$order]" />
              <set_value name="$logHold.$logVoyage" exact="@$diagnostic.$voyage" />
              <do_if value="@global.$mwexDebug">
                <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
                <set_value name="$mwtrace_file" exact="'economy'" />
                <set_value name="$mwtrace_text" exact="'HOLD_CREATE order=%s offer=%s ownerShip=%s amount=%s'.[$logHold.$logOrderId,$logHold.$offer,$ship,$logHold.$amount]" />
                <include_interrupt_actions ref="MWEX_Fleet_trace" />
              </do_if>
            </do_if>
          </do_if>
        </do_if>
        <do_if value="@$order.exists and @$order.trade.exists and $order.trade.amount == $leg.$amount">
          <set_value name="$leg.$buyOrder" exact="$order" />
        </do_if>
        <do_else>
          <set_value name="$ok" exact="false" />
          <break />
        </do_else>
      </do_for_each>
      <do_if value="$ok">
        <do_for_each name="$leg" in="$plan">
          <create_trade_order object="$ship" tradeoffer="$leg.$need" amount="$leg.$amount" immediate="false" name="$order" />
          <set_value name="$mwlog_order_cfg" exact="$cfg" />
          <set_value name="$mwlog_order_diagnostic" exact="$diagnostic" />
          <set_value name="$mwlog_order" exact="$order" />
          <set_value name="$mwlog_order_leg" exact="$leg" />
          <set_value name="$mwlog_side" exact="'sell'" />
          <include_interrupt_actions ref="MWEX_Log_order" />
          <do_if value="@$order.exists">
            <append_to_list name="$orders" exact="$order" />
            <do_if value="@$order.trade.exists and $order.trade.amount gt 0">
              <append_to_list name="global.$mwexFleetPending" exact="table[$ship=$ship,$offer=$leg.$need,$order=$order,$amount=$order.trade.amount]" />
              <do_if value="@global.$mwexDebug">
                <set_value name="$logHold" exact="global.$mwexFleetPending.{global.$mwexFleetPending.count}" />
                <set_value name="$logHold.$logOrderId" exact="'%s'.[$order]" />
                <set_value name="$logHold.$logVoyage" exact="@$diagnostic.$voyage" />
                <do_if value="@global.$mwexDebug">
                  <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
                  <set_value name="$mwtrace_file" exact="'economy'" />
                  <set_value name="$mwtrace_text" exact="'HOLD_CREATE order=%s offer=%s ownerShip=%s amount=%s'.[$logHold.$logOrderId,$logHold.$offer,$ship,$logHold.$amount]" />
                  <include_interrupt_actions ref="MWEX_Fleet_trace" />
                </do_if>
              </do_if>
            </do_if>
          </do_if>
          <do_if value="@$order.exists and @$order.trade.exists and $order.trade.amount == $leg.$amount">
            <set_value name="$leg.$sellOrder" exact="$order" />
          </do_if>
          <do_else>
            <set_value name="$ok" exact="false" />
            <break />
          </do_else>
        </do_for_each>
      </do_if>
      <do_if value="not $ok">
        <!-- Critical/running trades are NOT assumed cancellable. Keep voyage identity for real-cargo recovery. -->
        <do_for_each name="$created" in="$orders" reverse="true">
          <do_if value="@$created.exists and not $created.isrunning">
            <do_if value="@global.$mwexDebug">
              <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
              <set_value name="$mwtrace_text" exact="'ROLLBACK_CANCEL_REQUEST order=%s running=%s reason=create_incomplete'.[$created,@$created.isrunning]" />
              <set_value name="$mwtrace_file" exact="'orders'" />
              <include_interrupt_actions ref="MWEX_Fleet_trace" />
            </do_if>
            <cancel_order order="$created" />
            <do_if value="@global.$mwexDebug">
              <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
              <set_value name="$mwtrace_text" exact="'ROLLBACK_CANCEL_OBSERVED order=%s exists=%s running=%s'.[$created,@$created.exists,@$created.isrunning]" />
              <set_value name="$mwtrace_file" exact="'orders'" />
              <include_interrupt_actions ref="MWEX_Fleet_trace" />
            </do_if>
          </do_if>
        </do_for_each>
        <set_value name="$failure" exact="{61552,4458}" />
        <set_value name="$status" exact="'commit_create'" />
        <write_to_logbook category="alerts" object="$ship" title="{61552,4200}" text="{61552,4205}.[$ship.knownname]" interaction="showonmap" />
      </do_if>
      <do_if value="$ok">
        <set_value name="$status" exact="'success'" />
      </do_if>
      <do_if value="@global.$mwexFleetLock == $lock">
        <remove_value name="global.$mwexFleetLock" />
      </do_if>
      <do_if value="@global.$mwexDebug">
        <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
        <set_value name="$mwtrace_text" exact="'COMMIT status=%s lots=%s orders=%s success=%s'.[$status,$plan.count,$orders.count,$ok]" />
        <set_value name="$mwtrace_file" exact="'orders'" />
        <include_interrupt_actions ref="MWEX_Fleet_trace" />
      </do_if>
      <do_if value="@global.$mwexDebug">
        <do_for_each name="$leg" in="$plan" counter="$i">
          <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
          <set_value name="$mwtrace_text" exact="'COMMIT_LEG index=%s source=%s need=%s ware=%s amount=%s buy=%sCr sell=%sCr buyOrder=%s sellOrder=%s success=%s'.[$i,$leg.$source,$leg.$need,$leg.$ware,$leg.$amount,$leg.$buyprice/1Cr,$leg.$sellprice/1Cr,@$leg.$buyOrder,@$leg.$sellOrder,$ok]" />
          <set_value name="$mwtrace_file" exact="'orders'" />
          <include_interrupt_actions ref="MWEX_Fleet_trace" />
        </do_for_each>
      </do_if>
      <do_for_each name="$queued" in="$ship.orders" counter="$index">
        <do_if value="@global.$mwexDebug">
          <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
          <set_value name="$mwtrace_text" exact="'QUEUE ship=%s index=%s order=%s trade=%s amount=%s state=%s'.[$ship.idcode,$index,$queued,$queued.trade,@$queued.trade.amount,$queued.state]" />
          <set_value name="$mwtrace_file" exact="'orders'" />
          <include_interrupt_actions ref="MWEX_Fleet_trace" />
        </do_if>
      </do_for_each>
      <do_if value="$ok">
        <set_value name="$attempt" exact="@$ship.pilot.$mwexFleetAttempt" />
        <do_if value="$attempt and $attempt.$signature == $cfg.$signature and $attempt.$origin == $cfg.$origin">
          <set_value name="$attempt.$failures" exact="0" />
          <set_value name="$attempt.$misses" exact="0" />
          <do_if value="@global.$mwexDebug">
            <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
            <set_value name="$mwtrace_text" exact="'WAIT_RESET reason=orders_created previousWaitingSince=%s failures=%s misses=%s'.[$attempt.$waitingSince,$attempt.$failures,$attempt.$misses]" />
            <set_value name="$mwtrace_file" exact="'lifecycle'" />
            <include_interrupt_actions ref="MWEX_Fleet_trace" />
          </do_if>
          <set_value name="$attempt.$waitingSince" exact="null" />
          <set_value name="$attempt.$backoff" exact="2s" />
          <set_value name="$attempt.$next" exact="player.age+2s" />
        </do_if>
        <remove_value name="$ship.pilot.$mwexFleetSearchWide" />
        <remove_value name="$ship.pilot.$mwexFleetNeedOffset" />
        <do_if value="$hub">
          <do_for_each name="$completedLeg" in="$plan">
            <remove_value name="$hub.$warnings.{$completedLeg.$need}" />
            <remove_value name="$hub.$failures.{$completedLeg.$need}" />
          </do_for_each>
        </do_if>
      </do_if>
      <set_value name="$diagnostic.$status" exact="$status" />
      <set_value name="$diagnostic.$commitFailed" exact="not $ok" />
      <set_value name="$diagnostic.$failure" exact="if $ok then null else $failure" />
      <set_value name="$mwjournal_cfg" exact="$cfg" />
      <set_value name="$mwjournal_diagnostic" exact="$diagnostic" />
      <set_value name="$mwjournal_plan" exact="$plan" />
      <include_interrupt_actions ref="MWEX_Fleet_journal" />
      <return>
        <retval name="plan" value="$plan" />
        <retval name="ok" value="$ok" />
        <retval name="failure" value="if $ok then null else $failure" />
        <retval name="status" value="$status" />
      </return>
    </actions>
  </attention>
  <on_abort>
    <!--Only release this transaction's token. Submitted orders and voyage identity survive normal order preemption.-->
    <do_if value="$lock?">
      <do_if value="@global.$mwexFleetLock == $lock">
        <remove_value name="global.$mwexFleetLock" />
      </do_if>
    </do_if>
    <do_if value="@global.$mwexDebug and $diagnostic? and $diagnostic and not @$diagnostic.$recorded">
      <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
      <set_value name="$mwtrace_text" exact="'RESULT status=aborted success=false reason=script_interrupted'" />
      <set_value name="$mwtrace_file" exact="'lifecycle'" />
      <set_value name="$mwtrace_diagnostic.$logClosed" exact="true" />
      <set_value name="$mwtrace_diagnostic.$phase" exact="'finished'" />
      <include_interrupt_actions ref="MWEX_Fleet_trace" />
    </do_if>
  </on_abort>
</aiscript>
