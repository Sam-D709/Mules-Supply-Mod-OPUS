<?xml version="1.0" encoding="utf-8"?>
<aiscript name="mule.fleet.grade" version="1">
  <interrupts>
    <library>
      <actions name="MWEX_Fleet_grade">
        <!-- The validated pool is bounded at 192. No new trade queries or reservations. -->
        <set_value name="$mwgrade_logSamples" exact="0" />
        <set_value name="$mwgrade_bands" exact="table[]" />
        <set_value name="$mwgrade_need" exact="table[]" />
        <set_value name="$mwgrade_groups" exact="table[]" />
        <set_value name="$mwgrade_sources" exact="table[]" />
        <set_value name="$mwgrade_minLoad" exact="[$mwgrade_self.$minCargoUsed,25].max" />
        <do_for_each name="$mwgrade_c" in="$mwgrade_pool" counter="$mwgrade_index">
          <set_value name="$mwgrade_tag" exact="$mwgrade_c.$ware.transporttag" />
          <do_if value="not $mwgrade_bands.{$mwgrade_c.$ware}?">
            <set_value name="$mwgrade_sizes" exact="table[]" />
            <do_for_each name="$mwgrade_ship" valuename="$mwgrade_cfg" in="$mwgrade_hub.$members">
              <do_if value="$mwgrade_ship.isoperational and $mwgrade_ship.pilot.exists and not $mwgrade_ship.orders.count and $mwgrade_ship != player.occupiedship and $mwgrade_ship.defaultorder == $mwgrade_cfg.$origin and $mwgrade_cfg.$home == $mwgrade_hub.$home and (not $mwgrade_cfg.$bound or $mwgrade_ship.commander == $mwgrade_cfg.$commander) and $mwgrade_ship.cargo.{$mwgrade_c.$ware}.max gt 0 and (not $mwgrade_cfg.$lockWares or $mwgrade_cfg.$wares.indexof.{$mwgrade_c.$ware})">
                <set_value name="$mwgrade_size" exact="$mwgrade_ship.cargo.{$mwgrade_c.$ware}.max*$mwgrade_c.$ware.volume" />
                <set_value name="$mwgrade_sizes.{$mwgrade_ship}" exact="$mwgrade_size" />
              </do_if>
            </do_for_each>
            <set_value name="$mwgrade_own" exact="$mwgrade_self.$ship.cargo.{$mwgrade_c.$ware}.max*$mwgrade_c.$ware.volume" />
            <set_value name="$mwgrade_sizes.{$mwgrade_self.$ship}" exact="$mwgrade_own" />
            <set_value name="$mwgrade_refs" exact="[]" />
            <set_value name="$mwgrade_min" exact="0" />
            <set_value name="$mwgrade_ownBand" exact="0" />
            <do_for_each name="$mwgrade_ship" in="$mwgrade_sizes.keys.sorted">
              <set_value name="$mwgrade_size" exact="$mwgrade_sizes.{$mwgrade_ship}" />
              <do_if value="$mwgrade_min == 0 or $mwgrade_size gt $mwgrade_min*1.5">
                <append_to_list name="$mwgrade_refs" exact="$mwgrade_size" />
                <set_value name="$mwgrade_min" exact="$mwgrade_size" />
              </do_if>
              <do_else>
                <set_value name="$mwgrade_refs.{$mwgrade_refs.count}" exact="$mwgrade_size" />
              </do_else>
              <do_if value="$mwgrade_ship == $mwgrade_self.$ship">
                <set_value name="$mwgrade_ownBand" exact="$mwgrade_refs.count" />
              </do_if>
            </do_for_each>
            <set_value name="$mwgrade_bands.{$mwgrade_c.$ware}" exact="table[$refs=$mwgrade_refs,$own=$mwgrade_ownBand]" />
          </do_if>
          <do_if value="not $mwgrade_need.{$mwgrade_c.$need}?">
            <set_value name="$mwgrade_need.{$mwgrade_c.$need}" exact="table[$supply=0,$sources=table[],$net=$mwgrade_c.$needNet,$volume=0]" />
            <set_value name="$mwgrade_diagnostic.$demandVolume" operation="add" exact="$mwgrade_c.$needNet*$mwgrade_c.$ware.volume" />
          </do_if>
          <set_value name="$mwgrade_n" exact="$mwgrade_need.{$mwgrade_c.$need}" />
          <do_if value="not $mwgrade_n.$sources.{$mwgrade_c.$source}?">
            <set_value name="$mwgrade_n.$sources.{$mwgrade_c.$source}" exact="true" />
            <set_value name="$mwgrade_n.$supply" operation="add" exact="$mwgrade_c.$sourceNet" />
            <set_value name="$mwgrade_n.$volume" exact="[$mwgrade_n.$supply,$mwgrade_n.$net].min*$mwgrade_c.$ware.volume" />
          </do_if>
          <do_if value="not $mwgrade_sources.{$mwgrade_c.$source}?">
            <set_value name="$mwgrade_sources.{$mwgrade_c.$source}" exact="true" />
            <set_value name="$mwgrade_diagnostic.$supplyVolume" operation="add" exact="$mwgrade_c.$sourceNet*$mwgrade_c.$ware.volume" />
          </do_if>
          <set_value name="$mwgrade_key" exact="'$receiver/%s/%s'.[$mwgrade_c.$need.owner,$mwgrade_tag]" />
          <do_if value="not $mwgrade_groups.{$mwgrade_key}?">
            <set_value name="$mwgrade_groups.{$mwgrade_key}" exact="table[$sizes=table[],$volume=0]" />
          </do_if>
          <set_value name="$mwgrade_groups.{$mwgrade_key}.$sizes.{$mwgrade_index}" exact="[$mwgrade_c.$sourceNet,$mwgrade_c.$needNet].min*$mwgrade_c.$ware.volume" />
        </do_for_each>
        <!-- Upper bound for up to maxTrades lots to ONE receiver/tag; no cross-station pooling. -->
        <do_for_each valuename="$mwgrade_group" in="$mwgrade_groups">
          <set_value name="$mwgrade_used" exact="table[]" />
          <set_value name="$mwgrade_seen" exact="table[]" />
          <set_value name="$mwgrade_lots" exact="0" />
          <do_for_each name="$mwgrade_index" in="$mwgrade_group.$sizes.keys.sorted" reverse="true">
            <set_value name="$mwgrade_c" exact="$mwgrade_pool.{$mwgrade_index}" />
            <do_if value="$mwgrade_seen.{$mwgrade_c.$source}?">
              <continue />
            </do_if>
            <set_value name="$mwgrade_remaining" exact="$mwgrade_c.$needNet-@$mwgrade_used.{$mwgrade_c.$need}" />
            <set_value name="$mwgrade_amount" exact="[$mwgrade_remaining,$mwgrade_c.$sourceNet].min" />
            <do_if value="$mwgrade_amount le 0">
              <continue />
            </do_if>
            <set_value name="$mwgrade_seen.{$mwgrade_c.$source}" exact="true" />
            <set_value name="$mwgrade_used.{$mwgrade_c.$need}" exact="@$mwgrade_used.{$mwgrade_c.$need}+$mwgrade_amount" />
            <set_value name="$mwgrade_group.$volume" operation="add" exact="$mwgrade_amount*$mwgrade_c.$ware.volume" />
            <set_value name="$mwgrade_lots" operation="add" exact="1" />
            <do_if value="$mwgrade_lots ge $mwgrade_self.$maxTrades">
              <break />
            </do_if>
          </do_for_each>
        </do_for_each>
        <do_for_each name="$mwgrade_c" in="$mwgrade_pool">
          <set_value name="$mwgrade_tag" exact="$mwgrade_c.$ware.transporttag" />
          <set_value name="$mwgrade_band" exact="$mwgrade_bands.{$mwgrade_c.$ware}" />
          <set_value name="$mwgrade_volume" exact="$mwgrade_need.{$mwgrade_c.$need}.$volume" />
          <set_value name="$mwgrade_key" exact="'$receiver/%s/%s'.[$mwgrade_c.$need.owner,$mwgrade_tag]" />
          <set_value name="$mwgrade_target" exact="1" />
          <set_value name="$mwgrade_previous" exact="0" />
          <do_for_each name="$mwgrade_ref" in="$mwgrade_band.$refs" counter="$mwgrade_i">
            <do_if value="$mwgrade_volume*100 ge $mwgrade_ref*$mwgrade_minLoad or ($mwgrade_groups.{$mwgrade_key}.$volume*100 ge $mwgrade_ref*$mwgrade_minLoad and $mwgrade_volume gt $mwgrade_previous*1.5)">
              <set_value name="$mwgrade_target" exact="$mwgrade_i" />
            </do_if>
            <set_value name="$mwgrade_previous" exact="$mwgrade_ref" />
          </do_for_each>
          <set_value name="$mwgrade_c.$mainPreferred" exact="$mwgrade_relaxed or $mwgrade_target == $mwgrade_band.$own or ($mwgrade_band.$own gt $mwgrade_target and $mwgrade_groups.{$mwgrade_key}.$volume*100 ge $mwgrade_band.$refs.{$mwgrade_band.$own}*$mwgrade_minLoad)" />
          <set_value name="$mwgrade_c.$grade" exact="$mwgrade_target" />
          <set_value name="$mwgrade_c.$ownGrade" exact="$mwgrade_band.$own" />
          <do_if value="@global.$mwexDebug and (@global.$mwexM4TraceCandidates or (not $mwgrade_c.$mainPreferred and $mwgrade_logSamples lt 3))">
            <set_value name="$mwgrade_logSamples" exact="$mwgrade_logSamples+1" />
            <do_if value="@global.$mwexDebug">
              <set_value name="$mwtrace_diagnostic" exact="$mwgrade_diagnostic" />
              <set_value name="$mwtrace_text" exact="'GRADE source=%s need=%s ware=%s shipBand=%s lotBand=%s refs=%s needVolume=%s receiverGroupVolume=%s minLoad=%s preferred=%s relaxed=%s'.[$mwgrade_c.$source,$mwgrade_c.$need,$mwgrade_c.$ware,$mwgrade_c.$ownGrade,$mwgrade_c.$grade,$mwgrade_band.$refs,$mwgrade_volume,$mwgrade_groups.{$mwgrade_key}.$volume,$mwgrade_minLoad,$mwgrade_c.$mainPreferred,$mwgrade_relaxed]" />
              <set_value name="$mwtrace_file" exact="'search'" />
              <include_interrupt_actions ref="MWEX_Fleet_trace" />
            </do_if>
          </do_if>
          <do_if value="not $mwgrade_c.$mainPreferred">
            <set_value name="$mwgrade_diagnostic.$gradeDeferred" operation="add" exact="1" />
          </do_if>
        </do_for_each>
      </actions>
    </library>
  </interrupts>
  <attention min="unknown">
    <actions>
      <return />
    </actions>
  </attention>
</aiscript>
