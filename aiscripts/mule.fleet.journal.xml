<?xml version='1.0' encoding='utf-8'?>
<aiscript name="mule.fleet.journal" version="5">
  <params>
    <param name="cfg" />
    <param name="diagnostic" />
    <param name="phase" default="null" />
    <param name="outcome" default="null" />
    <param name="force" default="false" />
    <param name="normal" default="null" />
    <param name="plan" default="[]" />
  </params>
  <interrupts>
    <library>
      <actions name="MWEX_Fleet_journal">
        <do_all exact="1">
          <set_value name="$mwjournal_ship" exact="$mwjournal_cfg.$ship" />
          <do_if value="not $mwjournal_ship.isoperational or not $mwjournal_ship.pilot.exists or not $mwjournal_diagnostic">
            <break />
          </do_if>
          <do_if value="@$mwjournal_diagnostic.$recorded">
            <break />
          </do_if>
          <set_value name="$mwjournal_diagnostic.$recorded" exact="true" />
          <remove_value name="$mwjournal_ship.pilot.$mwexFleetJournalLast" />
          <remove_value name="$mwjournal_ship.pilot.$mwexFleetJournalSerial" />
          <do_if value="@global.$mwexDebug">
            <set_value name="$mwjournal_search" exact="@$mwjournal_diagnostic.$logSearchSnapshot" />
            <set_value name="$mwjournal_committedVolume" exact="null" />
            <set_value name="$mwjournal_committedCapacity" exact="null" />
            <set_value name="$mwjournal_committedLots" exact="null" />
            <do_if value="$mwjournal_diagnostic.$status == 'success'">
              <set_value name="$mwjournal_committedVolume" exact="0" />
              <set_value name="$mwjournal_committedCapacity" exact="$mwjournal_diagnostic.$capacity" />
              <set_value name="$mwjournal_committedLots" exact="$mwjournal_plan.count" />
              <do_for_each name="$mwjournal_committedLeg" in="$mwjournal_plan">
                <set_value name="$mwjournal_committedVolume" operation="add" exact="$mwjournal_committedLeg.$amount*$mwjournal_committedLeg.$ware.volume" />
              </do_for_each>
            </do_if>
            <set_value name="$mwload_volume" exact="$mwjournal_committedVolume" />
            <set_value name="$mwload_capacity" exact="$mwjournal_committedCapacity" />
            <include_interrupt_actions ref="MWEX_Log_load" />
            <set_value name="$mwtrace_diagnostic" exact="$mwjournal_diagnostic" />
            <set_value name="$mwtrace_event" exact="'RESULT'" />
            <set_value name="$mwtrace_fields" exact="'capacityBasis,status,success,reason,detail,searchVolume,searchCapacity,searchLots,searchLoadPercent,searchLoadState,searchSnapshotSession,committedVolume,committedCapacity,committedLots,committedLoadPercent,committedLoadState,committedState,wait,minLoad,repaired,checks,extensions,candidateBudget,routeBudget,gradeDeferred,loadRejected,pool,searchAcceptedPlan,searchPartialBelowLoad,acceptedStates,loadBlockedStates'" />
            <set_value name="$mwtrace_text" exact="'RESULT status=%s success=%s reason=%s detail=%s searchVolume=%s searchCapacity=%s searchLots=%s searchLoadPercent=%s searchLoadState=%s searchSnapshotSession=%s committedVolume=%s committedCapacity=%s committedLots=%s committedLoadPercent=%s committedLoadState=%s committedState=%s wait=%s minLoad=%s repaired=%s checks=%s extensions=%s candidateBudget=%s routeBudget=%s gradeDeferred=%s loadRejected=%s pool=%s searchAcceptedPlan=%s searchPartialBelowLoad=%s acceptedStates=%s loadBlockedStates=%s capacityBasis=last_ware_whole_unit_limit'.[$mwjournal_diagnostic.$status,$mwjournal_diagnostic.$status == 'success',if $mwjournal_diagnostic.$status == 'success' then 'orders_created' else $mwjournal_diagnostic.$status,@$mwjournal_diagnostic.$failure,@$mwjournal_search.$volume,@$mwjournal_search.$capacity,@$mwjournal_search.$lots,@$mwjournal_search.$loadPercent,if $mwjournal_search then $mwjournal_search.$loadState else 'snapshot_unavailable',@$mwjournal_search.$session.$session,$mwjournal_committedVolume,$mwjournal_committedCapacity,$mwjournal_committedLots,$mwload_out_percent,if $mwjournal_diagnostic.$status == 'success' then $mwload_out_code else 'not_committed',if $mwjournal_diagnostic.$status == 'success' then 'orders_created' else 'not_committed',@$mwjournal_diagnostic.$waitAge,@$mwjournal_diagnostic.$minLoad,@$mwjournal_diagnostic.$repaired,@$mwjournal_diagnostic.$checks,@$mwjournal_diagnostic.$expanded,@$mwjournal_diagnostic.$candidateBudget,@$mwjournal_diagnostic.$routeBudget,@$mwjournal_diagnostic.$gradeDeferred,@$mwjournal_diagnostic.$loadRejected,@$mwjournal_diagnostic.$pool,@$mwjournal_diagnostic.$logHasAcceptedPlan,@$mwjournal_diagnostic.$logPartialLoadBlocked,@$mwjournal_diagnostic.$logAcceptedStates,@$mwjournal_diagnostic.$logLoadBlockedStates]" />
            <set_value name="$mwtrace_file" exact="'lifecycle'" />
            <set_value name="$mwtrace_diagnostic.$logClosed" exact="true" />
            <set_value name="$mwtrace_diagnostic.$phase" exact="'finished'" />
            <include_interrupt_actions ref="MWEX_Fleet_trace" />
          </do_if>
          <do_if value="not ($mwjournal_diagnostic.$status == 'success') and $mwjournal_ship.pilot.$mwexFleetBrief?">
            <set_value name="$mwjournal_last" exact="$mwjournal_ship.pilot.$mwexFleetBrief" />
            <do_if value="$mwjournal_last.$signature == $mwjournal_cfg.$signature and $mwjournal_last.$home == $mwjournal_cfg.$home and @$mwjournal_last.$status == $mwjournal_diagnostic.$status and player.age lt $mwjournal_last.$time+10min">
              <break />
            </do_if>
          </do_if>
          <do_if value="($mwjournal_diagnostic.$status == 'success')">
            <remove_value name="$mwjournal_ship.pilot.$mwexFleetBrief" />
          </do_if>
          <do_else>
            <set_value name="$mwjournal_ship.pilot.$mwexFleetBrief" exact="table[$signature=$mwjournal_cfg.$signature,$home=$mwjournal_cfg.$home,$status=$mwjournal_diagnostic.$status,$time=player.age]" />
          </do_else>
          <set_value name="$mwsummary_diagnostic" exact="$mwjournal_diagnostic" />
          <set_value name="$mwsummary_cfg" exact="$mwjournal_cfg" />
          <include_interrupt_actions ref="MWEX_Fleet_summary" />
          <set_value name="$mwjournal_body" exact="$mwsummary_out_text" />
          <set_value name="$mwjournal_legs" exact="if ($mwjournal_diagnostic.$status == 'success') then $mwjournal_plan else @$mwjournal_diagnostic.$draft" />
          <do_for_each name="$mwjournal_leg" in="$mwjournal_legs" counter="$mwjournal_i">
            <set_value name="$mwjournal_body" exact="$mwjournal_body+'\n'+{61552,4443}.[$mwjournal_i,$mwjournal_leg.$ware.name,$mwjournal_leg.$amount,$mwjournal_leg.$source.owner.knownname,$mwjournal_leg.$need.owner.knownname]" />
          </do_for_each>
          <set_value name="$mwjournal_title" exact="if ($mwjournal_diagnostic.$status == 'success') then {61552,4420} else if $mwjournal_diagnostic.$commitFailed then {61552,4424} else if $mwjournal_diagnostic.$status == 'load' then {61552,4421} else if $mwjournal_diagnostic.$status == 'budget' then {61552,4423} else {61552,4422}" />
          <write_to_logbook category="general" object="$mwjournal_ship" entity="$mwjournal_ship.pilot" interaction="showonmap" title="{61552,4444}.[$mwjournal_ship.idcode,$mwjournal_title]" text="$mwjournal_body" />
          <break />
        </do_all>
      </actions>
    </library>
  </interrupts>
  <patch sinceversion="3">
    <return />
  </patch>
  <patch sinceversion="5">
    <return />
  </patch>
  <patch sinceversion="4">
    <return />
  </patch>
  <attention min="unknown">
    <actions>
      <set_value name="$mwjournal_cfg" exact="$cfg" />
      <set_value name="$mwjournal_diagnostic" exact="$diagnostic" />
      <set_value name="$mwjournal_plan" exact="$plan" />
      <include_interrupt_actions ref="MWEX_Fleet_journal" />
      <return />
    </actions>
  </attention>
</aiscript>
