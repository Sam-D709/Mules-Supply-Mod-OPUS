<?xml version="1.0" encoding="utf-8"?>
<aiscript name="mule.fleet.plan" version="4">
  <params><param name="hub"/><param name="cfg"/><param name="relaxed" default="false"/></params>
  <patch sinceversion="4"><return><retval name="plan" value="[]"/><retval name="volume" value="0"/><retval name="failure" value="'ship_changed'"/></return></patch>
  <attention min="unknown"><actions>
    <set_value name="$ship" exact="$cfg.$ship"/>
    <set_value name="$home" exact="$cfg.$home"/>
    <set_value name="$homeSector" exact="if $home.isclass.sector then $home else $home.sector"/>
    <set_value name="$plan" exact="[]"/>
    <set_value name="$volume" exact="0"/>
    <set_value name="$capacity" exact="0"/>
    <set_value name="$receiver" exact="null"/>
    <set_value name="$cargoTag" exact="null"/>
    <set_value name="$budget" exact="$ship.money"/>
    <set_value name="$receiverBudget" exact="0Cr"/>
    <set_value name="$usedNeed" exact="table[]"/>
    <set_value name="$usedSource" exact="table[]"/>
    <set_value name="$ranks" exact="table[]"/>
    <do_if value="not $hub.$prices?"><set_value name="$hub.$prices" exact="table[]"/></do_if>
    <set_value name="$examined" exact="0"/>
    <set_value name="$rankChecks" exact="0"/>
    <set_value name="$deviations" exact="table[]"/>
    <set_value name="$batch" exact="20"/>
    <set_value name="$failure" exact="{61552,4300}"/>
    <!-- Build category/scope buckets; volume is compared WITHIN a bucket, never against different unit prices. -->
    <do_for_each name="$need" in="$hub.$needs">
      <set_value name="$rankChecks" operation="add" exact="1"/>
      <do_if value="$rankChecks ge 128">
        <set_value name="global.$mwexFleetLock.$time" exact="player.age"/><wait exact="1ms"/>
        <set_value name="$rankChecks" exact="0"/>
      </do_if>
      <do_if value="not @$need.exists or $ship.cargo.{$need.ware}.max le 0"><continue/></do_if>
      <do_if value="$cfg.$lockWares and not $cfg.$wares.indexof.{$need.ware}"><continue/></do_if>
      <set_value name="$owner" exact="if $need.owner.isclass.buildstorage then $need.owner.base else $need.owner"/>
      <set_value name="$scope" exact="2"/>
      <do_if value="$owner == $home"><set_value name="$scope" exact="0"/></do_if>
      <do_elseif value="$owner.sector == $homeSector"><set_value name="$scope" exact="1"/></do_elseif>
      <do_if value="$cfg.$dedicatedServe and (($home.isclass.sector and $scope gt 1) or (not $home.isclass.sector and $scope gt 0))"><continue/></do_if>
      <do_if value="$scope gt 0 and not $home.isclass.sector and $home.owner != faction.player and $owner.owner == faction.player"><continue/></do_if>
      <do_if value="$scope gt 0 and ($home.isclass.sector or $home.owner == faction.player) and $owner.owner != faction.player"><continue/></do_if>
      <do_if value="$scope gt 1 and not $home.isclass.sector and $home.owner != faction.player"><continue/></do_if>
      <set_value name="$category" exact="3"/>
      <do_if value="$need.owner.isclass.buildstorage">
        <do_if value="not $cfg.$allowBuildstorage"><continue/></do_if>
        <set_value name="$category" exact="0"/>
      </do_if>
      <do_else>
        <set_value name="$resource" exact="$need.owner.resources.{$need.ware}.exists or $need.owner.supplyresources.{$need.ware}.exists"/>
        <set_value name="$product" exact="$need.owner.products.{$need.ware}.exists"/>
        <do_if value="$resource and not $product">
          <do_if value="not $cfg.$allowResources"><continue/></do_if>
          <set_value name="$category" exact="1"/>
        </do_if>
        <do_elseif value="$resource and $product">
          <do_if value="not $cfg.$allowIntermediates"><continue/></do_if>
          <set_value name="$category" exact="2"/>
        </do_elseif>
        <do_else>
          <!-- Trade-only stock is supplied from real buy offers, without a separate ware-class switch. -->
          <do_if value="$product or not $need.owner.tradewares.{$need.ware}.exists"><continue/></do_if>
        </do_else>
      </do_else>
      <set_value name="$rank" exact="$scope*4+$category+1"/>
      <do_if value="not $ranks.{$rank}?"><set_value name="$ranks.{$rank}" exact="[]"/></do_if>
      <append_to_list name="$ranks.{$rank}" exact="$need"/>
    </do_for_each>
    <do_all exact="$cfg.$maxTrades" counter="$lotIndex">
      <set_value name="$chosen" exact="null"/>
      <do_all exact="12" counter="$rank">
        <do_if value="not $ranks.{$rank}?"><continue/></do_if>
        <set_value name="$volumes" exact="table[]"/>
        <do_for_each name="$need" in="$ranks.{$rank}">
          <set_value name="$rankChecks" operation="add" exact="1"/>
          <do_if value="$rankChecks ge 128">
            <set_value name="global.$mwexFleetLock.$time" exact="player.age"/><wait exact="1ms"/>
            <set_value name="$rankChecks" exact="0"/>
          </do_if>
          <do_if value="$receiver and $need.owner != $receiver"><continue/></do_if>
          <do_if value="$cargoTag and $need.ware.transporttag != $cargoTag"><continue/></do_if>
          <run_script name="'mule.fleet.net'"><param name="offer" value="$need"/><save_retval name="net" variable="$net"/></run_script>
          <set_value name="$net" exact="[$net - (if $usedNeed.{$need}? then $usedNeed.{$need} else 0),0].max"/>
          <do_if value="$net gt 0"><set_value name="$volumes.{$need}" exact="$net*$need.ware.volume"/></do_if>
        </do_for_each>
        <do_for_each name="$need" in="$volumes.keys.sorted" reverse="true">
          <set_value name="$failure" exact="{61552,4301}"/>
          <do_if value="not $hub.$sources.{$need.ware}?">
            <set_value name="$hub.$failures.{$need}" exact="{61552,4301}"/>
            <set_value name="$hub.$cacheDirty" exact="true"/>
            <continue/>
          </do_if>
          <run_script name="'mule.fleet.offer'">
            <param name="offer" value="$need"/><param name="ship" value="$ship"/><param name="home" value="$home"/><param name="maxDist" value="$cfg.$maxDist"/>
            <save_retval name="offer" variable="$validNeed"/><save_retval name="reason" variable="$failure"/>
          </run_script>
          <do_if value="not $validNeed">
            <set_value name="$hub.$failures.{$need}" exact="$failure"/>
            <continue/>
          </do_if>
          <set_value name="$bestSource" exact="null"/>
          <set_value name="$bestDistance" exact="2147483647"/>
          <set_value name="$bestScore" exact="0Cr"/>
          <set_value name="$bestDetour" exact="2147483647"/>
          <set_value name="$bestAmount" exact="0"/>
          <set_value name="$ware" exact="$need.ware"/>
          <run_script name="'mule.fleet.price'"><param name="offer" value="$validNeed"/><param name="ship" value="$ship"/><param name="cache" value="$hub.$prices"/><save_retval name="price" variable="$needPrice"/><save_retval name="ok" variable="$priced"/></run_script>
          <do_if value="not $priced"><set_value name="$failure" exact="{61552,4302}"/><set_value name="$hub.$failures.{$need}" exact="$failure"/><continue/></do_if>
          <set_value name="$legCapacity" exact="$ship.cargo.{$ware}.max*$ware.volume"/>
          <set_value name="$free" exact="[($ship.cargo.{$ware}.free*$ware.volume)-$volume,$ship.cargo.free.all-$volume].min"/>
          <run_script name="'mule.fleet.net'"><param name="offer" value="$need"/><save_retval name="net" variable="$needNet"/></run_script>
          <set_value name="$needNet" exact="[$needNet - (if $usedNeed.{$need}? then $usedNeed.{$need} else 0),0].max"/>
          <do_for_each valuename="$sectorSources" in="$hub.$sources.{$ware}">
            <do_for_each valuename="$source" in="$sectorSources">
              <set_value name="$examined" operation="add" exact="1"/>
              <do_if value="$examined ge $batch">
                <set_value name="global.$mwexFleetLock.$time" exact="player.age"/>
                <wait exact="1ms"/>
                <set_value name="$examined" exact="0"/>
                <do_if value="not $ship.isoperational or $ship.orders.count or not $ship.pilot.$mwexFleetCfg or $ship.pilot.$mwexFleetCfg != $cfg">
                  <return><retval name="plan" value="[]"/><retval name="volume" value="0"/><retval name="failure" value="'ship_changed'"/></return>
                </do_if>
              </do_if>
              <do_if value="not @$source.available"><set_value name="$failure" exact="{61552,4316}"/><debug_to_file directory="'MulesExtended'" name="'M4 Capacity Candidates'" append="true" text="'REJECT ship=%s offer=%s reason=%s'.[$ship.idcode,$source,$failure]"/><continue/></do_if>
              <do_if value="$source.owner == $need.owner"><continue/></do_if>
              <do_if value="($source.owner.owner == faction.player and not $cfg.$allowPlayerSuppliers) or ($source.owner.owner != faction.player and not $cfg.$allowAiSuppliers)">
                <set_value name="$failure" exact="{61552,4315}.[$source.owner.knownname]"/>
                <debug_to_file directory="'MulesExtended'" name="'M4 Capacity Candidates'" append="true" text="$failure"/><continue/>
              </do_if>
              <do_if value="$usedSource.{$source}?"><continue/></do_if>
              <set_value name="$selfOwned" exact="$source.owner.owner == $ship.owner"/>
              <do_if value="$selfOwned and ($source.owner.cargo.{$ware}.target le 0 or $source.owner.cargo.{$ware}.count*100 le $source.owner.cargo.{$ware}.target*$cfg.$playerStockThreshold)">
                <set_value name="$failure" exact="{61552,4303}.[$source.owner.knownname,$ware.name,$source.owner.cargo.{$ware}.count,$source.owner.cargo.{$ware}.target,$cfg.$playerStockThreshold]"/>
                <debug_to_file directory="'MulesExtended'" name="'M4 Capacity Candidates'" append="true" text="$failure"/><continue/>
              </do_if>
              <run_script name="'mule.fleet.offer'">
                <param name="offer" value="$source"/><param name="ship" value="$ship"/><param name="home" value="$home"/><param name="maxDist" value="$cfg.$maxDist"/>
                <save_retval name="offer" variable="$validSource"/><save_retval name="reason" variable="$failure"/><save_retval name="distance" variable="$distance"/>
              </run_script>
              <do_if value="not $validSource"><continue/></do_if>
              <run_script name="'mule.fleet.price'"><param name="offer" value="$validSource"/><param name="ship" value="$ship"/><param name="cache" value="$hub.$prices"/><save_retval name="price" variable="$supplyPrice"/><save_retval name="ok" variable="$priced"/></run_script>
              <do_if value="not $priced"><set_value name="$failure" exact="{61552,4302}"/><continue/></do_if>
              <set_value name="$builder" exact="$cfg.$allowBuildstorage and not $cfg.$allowResources and not $cfg.$allowIntermediates and $need.owner.isclass.buildstorage and $need.owner.owner == faction.player"/>
              <do_if value="not $selfOwned and not $builder and $needPrice le $supplyPrice">
                <set_value name="$failure" exact="{61552,4304}.[$ware.name,$source.owner.knownname,$supplyPrice/1Cr,$need.owner.knownname,$needPrice/1Cr,$source.unitprice/1Cr]"/>
                <debug_to_file directory="'MulesExtended'" name="'M4 Capacity Candidates'" append="true" text="$failure"/><continue/>
              </do_if>
              <set_value name="$deviation" exact="0"/>
              <set_value name="$detour" exact="0"/>
              <do_if value="$plan.count">
                <!-- Corridor stays fixed, so all wares/suppliers in a sector share this draft-local result. -->
                <do_if value="not $deviations.{$source.owner.sector}?">
                  <set_value name="$deviation" exact="2147483647"/>
                  <do_for_each name="$pathSector" in="$corridor">
                    <set_value name="$d" exact="$pathSector.gatedistance.{$source.owner.sector}.{blacklistgroup.civilian}.{$ship}"/>
                    <do_if value="$d ge 0 and $d lt $deviation"><set_value name="$deviation" exact="$d"/></do_if>
                  </do_for_each>
                  <set_value name="$deviations.{$source.owner.sector}" exact="$deviation"/>
                </do_if>
                <set_value name="$deviation" exact="$deviations.{$source.owner.sector}"/>
                <set_value name="$failure" exact="{61552,4305}.[$source.owner.knownname,$deviation,$cfg.$corridorDepth]"/>
                <do_if value="$deviation gt $cfg.$corridorDepth"><debug_to_file directory="'MulesExtended'" name="'M4 Capacity Candidates'" append="true" text="$failure"/><continue/></do_if>
                <set_value name="$fromPrevious" exact="$previous.sector.gatedistance.{$source.owner.sector}.{blacklistgroup.civilian}.{$ship}"/>
                <set_value name="$backPrevious" exact="$previous.sector.gatedistance.{$homeSector}.{blacklistgroup.civilian}.{$ship}"/>
                <do_if value="$fromPrevious lt 0 or $backPrevious lt 0"><set_value name="$failure" exact="{61552,4307}"/><continue/></do_if>
                <set_value name="$detour" exact="$fromPrevious+$distance-$backPrevious"/>
              </do_if>
              <run_script name="'mule.fleet.net'"><param name="offer" value="$source"/><save_retval name="net" variable="$sourceNet"/></run_script>
              <set_value name="$amount" exact="[$needNet,$sourceNet,($free/$ware.volume)i].min"/>
              <clamp_trade_amount trade="$validSource" amount="$amount" buyer="$ship" seller="$source.owner" result="$amount"/>
              <clamp_trade_amount trade="$validNeed" amount="$amount" buyer="$need.owner" result="$amount"/>
              <set_value name="$paidPrice" exact="if $source.buyfree.{$ship} then 0Cr else $supplyPrice"/>
              <do_if value="$paidPrice gt 0Cr"><set_value name="$amount" exact="[$amount,($budget/$paidPrice)i].min"/></do_if>
              <do_if value="$receiver and not ($need.buyfree or $receiver.owner == $ship.owner) and $needPrice gt 0Cr">
                <set_value name="$amount" exact="[$amount,($receiverBudget/$needPrice)i].min"/>
              </do_if>
              <do_if value="$receiver">
                <set_value name="$amount" exact="[$amount,(($receiver.cargo.free.{$ware.transporttag}-$volume)/$ware.volume)i].min"/>
              </do_if>
              <set_value name="$failure" exact="{61552,4306}.[$source.owner.knownname,$ware.name,$needNet,$sourceNet,$free,$amount,$source.minamount,$need.minamount,$budget/1Cr,$supplyPrice/1Cr]"/>
              <do_if value="$amount le 0 or $amount lt $source.minamount or $amount lt $need.minamount"><debug_to_file directory="'MulesExtended'" name="'M4 Capacity Candidates'" append="true" text="$failure"/><continue/></do_if>
              <set_value name="$score" exact="$supplyPrice*(1+$deviation*$cfg.$corridorMarkup/100.0)"/>
              <set_value name="$better" exact="not $bestSource"/>
              <do_if value="$bestSource">
                <do_if value="$plan.count">
                  <set_value name="$better" exact="$score lt $bestScore or ($score == $bestScore and $detour lt $bestDetour)"/>
                </do_if>
                <do_else>
                  <set_value name="$better" exact="$distance lt $bestDistance or ($distance == $bestDistance and $score lt $bestScore)"/>
                </do_else>
              </do_if>
              <debug_to_file directory="'MulesExtended'" name="'M4 Capacity Candidates'" append="true"
                text="'CANDIDATE ship=%s need=%s supplier=%s ware=%s amount=%s homeDist=%s d=%s raw=%sCr actual=%sCr score=%sCr better=%s'.[$ship.idcode,$need.owner,$source.owner,$ware,$amount,$distance,$deviation,$source.unitprice/1Cr,$supplyPrice/1Cr,$score/1Cr,$better]"/>
              <do_if value="$better">
                <set_value name="$bestSource" exact="$source"/><set_value name="$bestPrice" exact="$supplyPrice"/>
                <set_value name="$bestAmount" exact="$amount"/>
                <set_value name="$bestDistance" exact="$distance"/>
                <set_value name="$bestScore" exact="$score"/>
                <set_value name="$bestDetour" exact="$detour"/>
              </do_if>
            </do_for_each>
          </do_for_each>
          <do_if value="$bestSource">
            <set_value name="$chosen" exact="table[$need=$need,$source=$bestSource,$ware=$ware,$amount=$bestAmount,$buyprice=$bestPrice,$sellprice=$needPrice]"/>
            <break/>
          </do_if>
          <set_value name="$hub.$failures.{$need}" exact="$failure"/>
        </do_for_each>
        <do_if value="$chosen"><break/></do_if>
      </do_all>
      <do_if value="not $chosen"><break/></do_if>
      <do_if value="not $plan.count">
        <set_value name="$receiver" exact="$chosen.$need.owner"/>
        <set_value name="$receiverBudget" exact="$receiver.money"/>
        <set_value name="$cargoTag" exact="$chosen.$ware.transporttag"/>
        <set_value name="$capacity" exact="$ship.cargo.{$chosen.$ware}.max*$chosen.$ware.volume"/>
        <get_global_path component="$path" resultdistance="$pathLength" multiple="true" useblacklist="blacklistgroup.civilian" refobject="$ship" useknownpath="true" uselocalhighways="not $ship.iscapitalship">
          <start object="$home"/><end object="$chosen.$source.owner"/>
        </get_global_path>
        <do_if value="$pathLength lt 0">
          <return><retval name="plan" value="[]"/><retval name="volume" value="0"/><retval name="failure" value="{61552,4307}"/></return>
        </do_if>
        <set_value name="$corridor" exact="[$homeSector]"/>
        <do_for_each name="$component" in="$path">
          <set_value name="$sector" exact="if $component.isclass.sector then $component else $component.sector"/>
          <do_if value="$sector and not $corridor.indexof.{$sector}"><append_to_list name="$corridor" exact="$sector"/></do_if>
        </do_for_each>
        <do_if value="not $corridor.indexof.{$chosen.$source.owner.sector}"><append_to_list name="$corridor" exact="$chosen.$source.owner.sector"/></do_if>
      </do_if>
      <append_to_list name="$plan" exact="$chosen"/>
      <set_value name="$volume" operation="add" exact="$chosen.$amount*$chosen.$ware.volume"/>
      <set_value name="$budget" exact="$budget - (if $chosen.$source.buyfree.{$ship} then 0Cr else $chosen.$amount*$chosen.$buyprice)"/>
      <set_value name="$receiverBudget" exact="$receiverBudget - (if $chosen.$need.buyfree or $receiver.owner == $ship.owner then 0Cr else $chosen.$amount*$chosen.$sellprice)"/>
      <set_value name="$usedNeed.{$chosen.$need}" exact="(if $usedNeed.{$chosen.$need}? then $usedNeed.{$chosen.$need} else 0)+$chosen.$amount"/>
      <set_value name="$usedSource.{$chosen.$source}" exact="$chosen.$amount"/>
      <set_value name="$previous" exact="$chosen.$source.owner"/>
      <do_if value="$volume ge $capacity"><break/></do_if>
    </do_all>
    <set_value name="$accepted" exact="$plan.count and ($relaxed or $volume*100 ge $capacity*$cfg.$minCargoUsed)"/>
    <do_if value="$plan.count and not $accepted"><set_value name="$failure" exact="{61552,4308}.[$volume,$capacity,$cfg.$minCargoUsed,$plan.count,$cfg.$maxTrades]"/><do_for_each name="$leg" in="$plan"><set_value name="$hub.$failures.{$leg.$need}" exact="$failure"/></do_for_each></do_if>
    <do_if value="$accepted"><set_value name="$failure" exact="'ok'"/></do_if>
    <debug_to_file directory="'MulesExtended'" name="'M4 Capacity Dispatch'" append="true"
      text="'DRAFT ship=%s capacity=%s volume=%s lots=%s max=%s relaxed=%s accepted=%s reason=%s'.[$ship.idcode,$capacity,$volume,$plan.count,$cfg.$maxTrades,$relaxed,$accepted,$failure]"/>
    <return><retval name="plan" value="if $accepted then $plan else []"/><retval name="volume" value="$volume"/><retval name="failure" value="$failure"/></return>
  </actions></attention>
</aiscript>
