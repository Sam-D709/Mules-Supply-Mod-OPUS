<?xml version="1.0" encoding="utf-8"?>
<aiscript name="mule.fleet.wave" version="16">
  <params>
    <param name="hub" />
    <param name="cfg" default="null" />
    <param name="debugTrigger" default="null" />
    <param name="debugReturnToken" default="null" />
  </params>
  <patch sinceversion="15">
    <return />
  </patch>
  <patch sinceversion="14">
    <return />
  </patch>
  <patch sinceversion="13">
    <return />
  </patch>
  <patch sinceversion="16">
    <return />
  </patch>
  <attention min="unknown">
    <actions>
      <!-- Each pilot searches only for itself. Returning ships never wait for a fleet-wide sweep. -->
      <do_if value="not $cfg">
        <return />
      </do_if>
      <set_value name="$ship" exact="$cfg.$ship" />
      <set_value name="$mwobserve_cfg" exact="$cfg" />
      <include_interrupt_actions ref="MWEX_Log_register" />
      <do_if value="not $ship.isoperational or not $ship.pilot.exists or $ship.orders.count or $ship == player.occupiedship or $cfg.$home != $hub.$home or $ship.defaultorder != $cfg.$origin or ($cfg.$origin.id == 'SupplyMule' and $cfg.$origin.$home != $cfg.$home) or ($cfg.$bound and $ship.commander != $cfg.$commander)">
        <set_value name="$mwstate_cfg" exact="$cfg" />
        <set_value name="$mwstate_value" exact="'skipped'" />
        <set_value name="$mwstate_reason" exact="if not $ship.isoperational then 'ship_not_operational' else if not $ship.pilot.exists then 'pilot_missing' else if $ship.orders.count then 'existing_orders' else if $ship == player.occupiedship then 'player_controlled' else 'binding_or_config_changed'" />
        <include_interrupt_actions ref="MWEX_Log_state" />
        <return />
      </do_if>
      <set_value name="$attempt" exact="@$ship.pilot.$mwexFleetAttempt" />
      <do_if value="not $attempt or $attempt.$signature != $cfg.$signature or $attempt.$origin != $cfg.$origin">
        <do_if value="@global.$mwexDebug">
          <set_value name="$mwtrace_diagnostic" exact="table[$ship=$ship,$attempt=null,$relaxed=false]" />
          <set_value name="$mwtrace_text" exact="'WAIT_RESET reason=configuration_or_origin oldWaitingSince=%s oldFailures=%s oldMisses=%s'.[@$attempt.$waitingSince,@$attempt.$failures,@$attempt.$misses]" />
          <set_value name="$mwtrace_file" exact="'lifecycle'" />
          <include_interrupt_actions ref="MWEX_Fleet_trace" />
        </do_if>
        <set_value name="$attempt" exact="table[$signature=$cfg.$signature,$origin=$cfg.$origin,$failures=0,$misses=0,$waitingSince=player.age,$next=0s,$backoff=2s]" />
        <set_value name="$ship.pilot.$mwexFleetAttempt" exact="$attempt" />
        <remove_value name="$ship.pilot.$mwexFleetSearchWide" />
        <remove_value name="$ship.pilot.$mwexFleetNeedOffset" />
      </do_if>
      <do_if value="player.age lt $attempt.$next">
        <set_value name="$mwstate_cfg" exact="$cfg" />
        <set_value name="$mwstate_value" exact="'backoff'" />
        <set_value name="$mwstate_reason" exact="'next_search_not_due'" />
        <include_interrupt_actions ref="MWEX_Log_state" />
        <return />
      </do_if>
      <do_if value="$ship.cargo.count">
        <set_value name="$mwstate_cfg" exact="$cfg" />
        <set_value name="$mwstate_value" exact="'recovering'" />
        <set_value name="$mwstate_reason" exact="'idle_cargo'" />
        <include_interrupt_actions ref="MWEX_Log_state" />
        <run_script name="'mule.fleet.recover'">
          <param name="cfg" value="$cfg" />
        </run_script>
        <do_if value="$ship.cargo.count">
          <return />
        </do_if>
      </do_if>
      <do_if value="$hub.$cacheDirty or player.age ge $hub.$cacheUntil or $hub.$cacheEpoch != global.$mwexFleetEpoch">
        <do_if value="not $hub.$building? or not @$hub.$building.$actor.exists or player.age gt $hub.$building.$time+60s">
          <set_value name="$build" exact="table[$actor=this,$time=player.age]" />
          <set_value name="$hub.$building" exact="$build" />
          <set_value name="$mwstate_cfg" exact="$cfg" />
          <set_value name="$mwstate_value" exact="'discovering'" />
          <set_value name="$mwstate_reason" exact="'cache_refresh'" />
          <include_interrupt_actions ref="MWEX_Log_state" />
          <run_script name="'mule.fleet.discover'">
            <param name="hub" value="$hub" />
          </run_script>
          <do_if value="@$hub.$building == $build">
            <remove_value name="$hub.$building" />
          </do_if>
        </do_if>
        <do_elseif value="not $hub.$needs.count">
          <set_value name="$mwstate_cfg" exact="$cfg" />
          <set_value name="$mwstate_value" exact="'waiting_index'" />
          <set_value name="$mwstate_reason" exact="'another_builder_no_index'" />
          <include_interrupt_actions ref="MWEX_Log_state" />
          <set_value name="$attempt.$next" exact="player.age+1s" />
          <return />
        </do_elseif>
      </do_if>
      <do_if value="not $attempt.$waitingSince?">
        <set_value name="$attempt.$waitingSince" exact="player.age" />
      </do_if>
      <do_elseif value="$attempt.$waitingSince == null">
        <set_value name="$attempt.$waitingSince" exact="player.age" />
      </do_elseif>
      <set_value name="$waitAge" exact="[0s,player.age-$attempt.$waitingSince].max" />
      <set_value name="$relaxed" exact="$attempt.$failures ge 3 or $waitAge ge 10min" />
      <set_value name="$ship.pilot.$mwexFleetLastSearch" exact="player.age" />
      <set_value name="$mwstate_cfg" exact="$cfg" />
      <set_value name="$mwstate_value" exact="'searching'" />
      <set_value name="$mwstate_reason" exact="if $debugTrigger? then $debugTrigger else 'normal'" />
      <include_interrupt_actions ref="MWEX_Log_state" />
      <do_if value="@global.$mwexDebug">
        <set_value name="$mwtrace_diagnostic" exact="table[$ship=$ship,$attempt=null,$relaxed=$relaxed]" />
        <set_value name="$mwtrace_text" exact="'WAVE_INPUT waitingSince=%s waitAge=%s failures=%s misses=%s backoff=%s next=%s trigger=%s returnToken=%s'.[$attempt.$waitingSince,$waitAge,$attempt.$failures,@$attempt.$misses,$attempt.$backoff,$attempt.$next,$debugTrigger,$debugReturnToken]" />
        <set_value name="$mwtrace_file" exact="'lifecycle'" />
        <include_interrupt_actions ref="MWEX_Fleet_trace" />
      </do_if>
      <run_script name="'mule.fleet.plan'">
        <param name="hub" value="$hub" />
        <param name="cfg" value="$cfg" />
        <param name="relaxed" value="$relaxed" />
        <param name="debugWait" value="$waitAge" />
        <param name="debugWaitingSince" value="$attempt.$waitingSince" />
        <param name="debugWave" value="this" />
        <save_retval name="plan" variable="$plan" />
        <save_retval name="failure" variable="$reason" />
        <save_retval name="diagnostic" variable="$diagnostic" />
      </run_script>
      <do_if value="$reason == 'ship_changed'">
        <do_if value="@global.$mwexDebug and $diagnostic">
          <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
          <set_value name="$mwtrace_text" exact="'RESULT status=ship_changed success=false'" />
          <set_value name="$mwtrace_file" exact="'lifecycle'" />
          <set_value name="$mwtrace_diagnostic.$logClosed" exact="true" />
          <set_value name="$mwtrace_diagnostic.$phase" exact="'finished'" />
          <include_interrupt_actions ref="MWEX_Fleet_trace" />
        </do_if>
        <return />
      </do_if>
      <set_value name="$ok" exact="false" />
      <do_if value="$plan.count">
        <set_value name="$diagnostic.$phase" exact="'commit'" />
        <set_value name="$mwstate_cfg" exact="$cfg" />
        <set_value name="$mwstate_value" exact="'committing'" />
        <set_value name="$mwstate_reason" exact="'plan_ready'" />
        <include_interrupt_actions ref="MWEX_Log_state" />
        <run_script name="'mule.fleet.commit'">
          <param name="cfg" value="$cfg" />
          <param name="plan" value="$plan" />
          <param name="diagnostic" value="$diagnostic" />
          <param name="hub" value="$hub" />
          <save_retval name="plan" variable="$plan" />
          <save_retval name="status" variable="$commitStatus" />
          <save_retval name="ok" variable="$ok" />
          <save_retval name="failure" variable="$reason" />
        </run_script>
        <do_if value="$reason == 'commit_busy'">
          <do_if value="@global.$mwexDebug">
            <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
            <set_value name="$mwtrace_text" exact="'RESULT status=commit_busy success=false'" />
            <set_value name="$mwtrace_file" exact="'lifecycle'" />
            <set_value name="$mwtrace_diagnostic.$logClosed" exact="true" />
            <set_value name="$mwtrace_diagnostic.$phase" exact="'finished'" />
            <include_interrupt_actions ref="MWEX_Fleet_trace" />
          </do_if>
          <set_value name="$attempt.$next" exact="player.age+1s" />
          <return />
        </do_if>
        <set_value name="$diagnostic.$status" exact="if $ok then 'success' else $commitStatus" />
        <set_value name="$diagnostic.$commitFailed" exact="not $ok" />
        <set_value name="$diagnostic.$failure" exact="$reason" />
        <set_value name="$mwjournal_cfg" exact="$cfg" />
        <set_value name="$mwjournal_diagnostic" exact="$diagnostic" />
        <set_value name="$mwjournal_plan" exact="$plan" />
        <include_interrupt_actions ref="MWEX_Fleet_journal" />
      </do_if>
      <set_value name="$attempt.$lastStatus" exact="$diagnostic.$status" />
      <do_if value="@global.$mwexDebug">
        <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
        <set_value name="$mwtrace_text" exact="'ATTEMPT_BEFORE_UPDATE status=%s failures=%s misses=%s waitingSince=%s next=%s budget=%s loadRejected=%s'.[$diagnostic.$status,$attempt.$failures,$attempt.$misses,$attempt.$waitingSince,$attempt.$next,$diagnostic.$budgetExhausted,$diagnostic.$loadRejected]" />
        <set_value name="$mwtrace_file" exact="'lifecycle'" />
        <include_interrupt_actions ref="MWEX_Fleet_trace" />
      </do_if>
      <do_if value="not $ok">
        <set_value name="$attempt.$misses" exact="@$attempt.$misses+1" />
        <do_if value="$diagnostic.$loadRejected and not $diagnostic.$budgetExhausted">
          <set_value name="$attempt.$failures" exact="[$attempt.$failures+1,3].min" />
        </do_if>
        <do_elseif value="not $diagnostic.$budgetExhausted">
          <set_value name="$attempt.$failures" exact="0" />
        </do_elseif>
        <set_value name="$ship.pilot.$mwexFleetSearchWide" exact="true" />
        <set_value name="$ship.pilot.$mwexFleetSearchOffset" exact="@$ship.pilot.$mwexFleetSearchOffset+2" />
        <set_value name="$attempt.$backoff" exact="[30s,$attempt.$backoff*2].min" />
        <set_value name="$attempt.$next" exact="player.age+$attempt.$backoff" />
        <do_if value="@global.$mwexDebug">
          <set_value name="$mwtrace_diagnostic" exact="$diagnostic" />
          <set_value name="$mwtrace_text" exact="'ATTEMPT_UPDATE failures=%s misses=%s waitingSince=%s backoff=%s next=%s needOffset=%s sourceOffset=%s'.[$attempt.$failures,$attempt.$misses,$attempt.$waitingSince,$attempt.$backoff,$attempt.$next,@$ship.pilot.$mwexFleetNeedOffset,@$ship.pilot.$mwexFleetSearchOffset]" />
          <set_value name="$mwtrace_file" exact="'lifecycle'" />
          <include_interrupt_actions ref="MWEX_Fleet_trace" />
        </do_if>
        <set_value name="$mwstate_cfg" exact="$cfg" />
        <set_value name="$mwstate_value" exact="'backoff'" />
        <set_value name="$mwstate_reason" exact="'search_unsuccessful'" />
        <include_interrupt_actions ref="MWEX_Log_state" />
        <do_if value="not $plan.count">
          <set_value name="$mwjournal_cfg" exact="$cfg" />
          <set_value name="$mwjournal_diagnostic" exact="$diagnostic" />
          <set_value name="$mwjournal_plan" exact="[]" />
          <include_interrupt_actions ref="MWEX_Fleet_journal" />
        </do_if>
        <set_value name="$mwreport_cfg" exact="$cfg" />
        <set_value name="$mwreport_reason" exact="$reason" />
        <include_interrupt_actions ref="MWEX_Fleet_report" />
        <!-- Retain throttled home alerts without another whole-fleet or whole-failure-table sweep. -->
        <set_value name="$need" exact="@$diagnostic.$lastNeed" />
        <do_if value="$need and not $diagnostic.$loadRejected and not $diagnostic.$budgetExhausted and (not $hub.$warnings.{$need}? or player.age ge $hub.$warnings.{$need}+10min)">
          <set_value name="$mwnet_offer" exact="$need" />
          <include_interrupt_actions ref="MWEX_Fleet_net" />
          <set_value name="$net" exact="$mwnet_out_net" />
          <do_if value="$net gt 0">
            <signal_objects object="player.entity" param="'mwex_capacity_warning'" param2="table[$station=$need.owner,$ware=$need.ware,$range=$cfg.$maxDist,$reason=$diagnostic.$lastFailure]" />
            <set_value name="$hub.$warnings.{$need}" exact="player.age" />
          </do_if>
        </do_if>
      </do_if>
      <return />
    </actions>
  </attention>
  <on_abort>
    <do_if value="@global.$mwexDebug and $ship? and @$ship.pilot.$mwexM4Search.$wave == this and not @$ship.pilot.$mwexM4Search.$logClosed">
      <do_if value="@global.$mwexDebug">
        <set_value name="$mwtrace_diagnostic" exact="$ship.pilot.$mwexM4Search" />
        <set_value name="$mwtrace_text" exact="'RESULT status=aborted success=false reason=script_interrupted stage=wave phase=%s cause=unknown'.[@$ship.pilot.$mwexM4Search.$phase]" />
        <set_value name="$mwtrace_file" exact="'lifecycle'" />
        <set_value name="$mwtrace_diagnostic.$logClosed" exact="true" />
        <set_value name="$mwtrace_diagnostic.$phase" exact="'finished'" />
        <include_interrupt_actions ref="MWEX_Fleet_trace" />
      </do_if>
    </do_if>
  </on_abort>
</aiscript>
